function calcVacuum(){
  const val = parseFloat(document.getElementById('vc-val').value) || 0;
  const unit = document.getElementById('vc-unit').value;
  
  // Convert to mmHg abs first
  let mmhg_abs;
  switch(unit){
    case 'mmhg-abs': mmhg_abs = val; break;
    case 'bar-gauge': mmhg_abs = (1.01325 + val) * 750.06; break;
    case 'psia': mmhg_abs = val * 51.7149; break;
    case 'kpa-abs': mmhg_abs = val * 7.5006; break;
    case 'torr': mmhg_abs = val; break;
  }
  
  // Convert from mmHg abs to all others
  const bar_g = mmhg_abs / 750.06 - 1.01325;
  const psia = mmhg_abs / 51.7149;
  const psig = psia - 14.696;
  const kpa_abs = mmhg_abs / 7.5006;
  const inhg = mmhg_abs / 25.4;
  
  // Vacuum classification
  let category, color;
  if(mmhg_abs > 760) { category = 'POSITIVE PRESSURE'; color = '#e74c3c'; }
  else if(mmhg_abs > 100) { category = 'ROUGH VACUUM'; color = '#f59e0b'; }
  else if(mmhg_abs > 30) { category = 'MEDIUM VACUUM (typical VDT)'; color = '#2ecc71'; }
  else if(mmhg_abs > 10) { category = 'DEEP VACUUM'; color = '#00d4ff'; }
  else { category = 'HIGH VACUUM (research)'; color = '#9b59b6'; }
  
  document.getElementById('vc-result').innerHTML = 
    '<div class="calc-result-title">CONVERSIONS</div>' +
