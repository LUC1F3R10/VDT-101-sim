  const sc = SCENARIOS[id];
  if(!sc) return;
  
  window._activeScenario = sc;
  window._scenarioState = {
    startTime: Date.now(),
    completed: [],
    failed: [],
    paused: false,
    scenarioId: id
  };
  
  // Clear all faults first
  if(typeof activeFaults !== 'undefined') activeFaults.clear();
  
  // Inject initial fault
  if(sc.initialFault){
    setTimeout(() => {
      if(typeof activeFaults !== 'undefined') activeFaults.add(sc.initialFault);
      showToastInline('⚠ FAULT INJECTED: ' + (FDB[sc.initialFault] ? FDB[sc.initialFault].title : sc.initialFault));
