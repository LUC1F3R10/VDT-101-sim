// Routing state
let routing = {llo:'storage', hlo:'storage', slop:'storage', res:'storage'};
let sopFeedPct = 100;
let sopFurnaceOn = true;

function setRouting(product, dest){
  routing[product] = dest;
  updateRoutingDisplay();
}

function updateRoutingDisplay(){
  // Update PROD tab routing badges
  const routeLabels = {storage:'→ STORAGE', slop:'→ SLOP', offline:'OFFLINE'};
  const routeColors = {storage:'#2ecc71', slop:'#f59e0b', offline:'#e74c3c'};
  [['llo','pr-rt-llo'],['hlo','pr-rt-hlo'],['slop','pr-rt-slop'],['res','pr-rt-res']].forEach(([p,id])=>{
    const dest = routing[p]||'storage';
    const el = document.getElementById(id);
    if(el){el.textContent = routeLabels[dest]||dest; el.style.color = routeColors[dest]||'#2ecc71';}
  });

  const colors = {storage:'#2ecc71', slop:'#f59e0b', offline:'#e74c3c'};
  const labels = {storage:'STORAGE', slop:'→ SLOP TANK', offline:'OFFLINE'};
  ['llo','hlo','slop','res'].forEach(p=>{
    const dest = routing[p] || 'storage';
    const destEl = document.getElementById('rt-'+p+'-dest');
    if(destEl){destEl.textContent = labels[dest]||dest; destEl.setAttribute('fill', colors[dest]||'#2ecc71');}
    const dotEl = document.getElementById('rt-'+p+'-dot');
    if(dotEl) dotEl.setAttribute('fill', dest==='offline'?'#e74c3c': dest==='slop'?'#f59e0b': 
      p==='llo'?'#7ecf3a': p==='hlo'?'#4ecdc4': p==='slop'?'#ff9f1a':'#888');
  });
  // Show/hide slop routing lines
  const lloSlop = document.getElementById('llo-slop-route');
  const hloSlop = document.getElementById('hlo-slop-route');
  if(lloSlop) lloSlop.style.display = routing.llo==='slop' ? 'block' : 'none';
  if(hloSlop) hloSlop.style.display = routing.hlo==='slop' ? 'block' : 'none';
}

function applySopAction(action, stepData){
  const feedSlider = document.getElementById('sl-feed');
  const tempSlider = document.getElementById('sl-temp');
  const pressSlider = document.getElementById('sl-press');

  switch(action){
    // ─── STARTUP ACTIONS ─────────────────────────────────
    case 'startup_0': // Pre-startup check — everything offline
      break;

    case 'startup_1': // Utilities ready
      // Start hot oil — set hboil to 220C
      const hboilSl = document.getElementById('sl-hboil');
      if(hboilSl){hboilSl.value=220;}
      sim();
      break;

    case 'startup_2': // Establish CW
      // CW flowing — visual only, no slider change needed
      break;

    case 'startup_3': // Start ejectors — build vacuum
      if(pressSlider){pressSlider.value=-0.85;} // partial vacuum first
      sim();
      showToast('Vacuum building... -0.85 bar');
      break;

    case 'startup_4': // Light furnace — low temp
      sopFurnaceOn = true;
      if(tempSlider){tempSlider.value=320;} // start low
      if(feedSlider){feedSlider.value=10000;} // minimal feed
      sim();
      showToast('Furnace lit — TI-003 target 320°C');
      set('rt-furn-stat','HEATING UP');
      setAttr('rt-furn-stat', 'fill','#f59e0b');
      break;

    case 'startup_5': // Introduce feed at 20%
      if(feedSlider){feedSlider.value=10000;} // 20% of 50000
      routing.llo='slop'; routing.hlo='slop'; routing.slop='storage'; routing.res='storage';
      updateRoutingDisplay();
      set('rt-feed-pct','20%');
      setAttr('rt-feed-pct', 'fill','#f59e0b');
      sim();
      showToast('Feed at 20% — all products routing to slop');
      break;

    case 'startup_6': // Establish draws — route to slop
      if(feedSlider){feedSlider.value=20000;} // 40%
      routing.llo='slop'; routing.hlo='slop'; routing.slop='storage'; routing.res='storage';
      updateRoutingDisplay();
      set('rt-feed-pct','40%');
      if(pressSlider){pressSlider.value=-0.93;}
      if(tempSlider){tempSlider.value=370;}
      sim();
      showToast('Products drawing — routed to slop pending lab');
      break;

    case 'startup_7': // Normal operation — route to storage
      if(feedSlider){feedSlider.value=50000;} // 100%
      if(tempSlider){tempSlider.value=405;}
      if(pressSlider){pressSlider.value=-0.933;}
      routing.llo='storage'; routing.hlo='storage'; routing.slop='storage'; routing.res='storage';
      updateRoutingDisplay();
      set('rt-feed-pct','100%');
      setAttr('rt-feed-pct', 'fill','#2ecc71');
      set('rt-furn-stat','ON-LINE');
      setAttr('rt-furn-stat', 'fill','#2ecc71');
      sim();
      showToast('Normal operation — all products to storage!');
      break;

    // ─── SHUTDOWN ACTIONS — INDUSTRY STANDARD SEQUENCE ────────────────────
    // Ref: Saudi Aramco / KOC CDU/VDU shutdown procedure
    // Order: 1) Reduce feed FIRST (furnace stays HOT)
    //        2) THEN reduce furnace COT gradually (after feed at 30-40%)
    //        3) Route products to slop
    //        4) Cut feed + steam, pilots only
    //        5) Break vacuum slowly
    //        6) Final cooldown + flush
    case 'shutdown_0': // STEP 1: Throughput reduction — FURNACE STAYS HOT!
      if(feedSlider){feedSlider.value=30000;} // 60%
      // CRITICAL: Furnace temp KEPT at 405°C
      if(tempSlider){tempSlider.value=405;}
      set('rt-feed-pct','60%');
      setAttr('rt-feed-pct', 'fill','#f59e0b');
      sim();
      showToast('STEP 1: Feed → 60% — Furnace KEPT HOT at 405°C');
      break;

    case 'shutdown_1': // STEP 2: Furnace COT reduction (AFTER feed reduced)
      if(feedSlider){feedSlider.value=20000;} // 40%
      // Now reduce furnace gradually
      if(tempSlider){tempSlider.value=320;} // minimum fire
      set('rt-feed-pct','40%');
      sim();
      showToast('STEP 2: Feed at 40% — NOW furnace reduced to 320°C minimum fire');
      break;

    case 'shutdown_2': // STEP 3: Route products to slop
      routing.llo='slop'; routing.hlo='slop'; routing.slop='slop';
      // Residue stays to TK-104 (still on-spec)
      routing.res='storage';
      updateRoutingDisplay();
      if(feedSlider){feedSlider.value=15000;}
      if(tempSlider){tempSlider.value=310;}
      set('rt-feed-pct','30%');
      sim();
      showToast('STEP 3: LLO/HLO/Slop → SLOP TANK, residue still to TK-104');
      break;

    case 'shutdown_3': // STEP 4: Cut feed, stripping steam, pilots only
      if(feedSlider){feedSlider.value=0;} // feed = 0
      if(tempSlider){tempSlider.value=250;} // pilot only
      const steamSlider = document.getElementById('sl-steam');
      if(steamSlider){steamSlider.value=0;} // cut stripping steam
      sopFurnaceOn = false;
      set('rt-feed-pct','0%');
      setAttr('rt-feed-pct', 'fill','#e74c3c');
      set('rt-furn-stat','PILOT ONLY');
      setAttr('rt-furn-stat', 'fill','#f59e0b');
      sim();
      showToast('STEP 4: Feed cut, steam off, furnace pilot only (250°C)');
      break;

    case 'shutdown_4': // STEP 5: Break vacuum SLOWLY
      if(pressSlider){pressSlider.value=-0.30;} // breaking gradually
      if(tempSlider){tempSlider.value=220;}
      sim();
      showToast('STEP 5: Vacuum being broken slowly via N2 vent valve');
      break;

    case 'shutdown_5': // STEP 6: Final cooldown + flush
      // Stop all pumps except P-104 (keeps draining)
      const p101s=document.getElementById('sl-p101');
      const p102s=document.getElementById('sl-p102');
      const p103s=document.getElementById('sl-p103');
      const p105s=document.getElementById('sl-p105');
      if(p101s) p101s.value=0;
      if(p102s) p102s.value=0;
      if(p103s) p103s.value=0;
      if(p105s) p105s.value=0;
      if(tempSlider) tempSlider.value=180;     // post-cooldown
      if(pressSlider) pressSlider.value=-0.05; // atmospheric
      routing.llo='offline'; routing.hlo='offline'; routing.slop='offline';
      // P-104 still routing to drain remaining residue
      updateRoutingDisplay();
      set('rt-furn-stat','OFFLINE');
      setAttr('rt-furn-stat', 'fill','#e74c3c');
      sim();
      showToast('STEP 6: Pumps stopped, P-104 still draining. Open 🧹 FLUSH to clean lines');
      // Auto-open flush modal
      setTimeout(()=>{ if(typeof openFlushModal==='function') openFlushModal(); }, 1500);
      break;

    // ─── RESET ───────────────────────────────────────────
    case 'reset':
      if(feedSlider){feedSlider.value=50000;}
      if(tempSlider){tempSlider.value=405;}
      if(pressSlider){pressSlider.value=-0.933;}
      routing={llo:'storage',hlo:'storage',slop:'storage',res:'storage'};
      sopFeedPct=100; sopFurnaceOn=true;
      updateRoutingDisplay();
      set('rt-feed-pct','100%');
      set('rt-furn-stat','ON-LINE');
      sim();
      break;
  }
}

