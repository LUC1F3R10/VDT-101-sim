    const state = window._scenarioState;
    const incompleteObj = sc.objectives.find((obj, i) => 
      !state.completed.includes(i) && !state.failed.includes(i)
    );
    
    if(incompleteObj && advice.length < 3){
      advice.push({
        priority: 4, urgency: 'GUIDE',
        icon: '🎯',
        title: 'NEXT OBJECTIVE',
        msg: incompleteObj.text,
        action: sc.tips[state.completed.length] || sc.tips[0] || 'Follow scenario procedure',
        color: '#9b59b6'
      });
    }
  }
  
  // ─── If no problems, show positive feedback ───
  if(advice.length === 0){
    advice.push({
      priority: 99, urgency: 'OK',
      icon: '✅',
      title: 'ALL SYSTEMS NORMAL',
      msg: 'Process parameters within normal operating range',
      action: 'Continue monitoring. Good operating discipline!',
      color: '#2ecc71'
    });
  }
  
  // Sort by priority
  advice.sort((a, b) => a.priority - b.priority);
  return advice;
}

