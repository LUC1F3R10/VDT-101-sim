  if(F < 30000 && !window._activeScenario){
    advice.push({
      priority: 4, urgency: 'INFO',
      icon: 'ℹ️',
      title: 'LOW FEED RATE',
      msg: 'Feed = ' + F.toFixed(0) + ' bbl/d (design 50k)',
      action: 'If intentional, OK. Otherwise check CDU feed availability',
      color: '#7a9ec2'
