function calcMassBal(){
  const feed = parseFloat(document.getElementById('mb-feed').value) || 0;
  const gas = parseFloat(document.getElementById('mb-gas').value) || 0;
  const lvgo = parseFloat(document.getElementById('mb-lvgo').value) || 0;
  const hvgo = parseFloat(document.getElementById('mb-hvgo').value) || 0;
  const slop = parseFloat(document.getElementById('mb-slop').value) || 0;
  const res = parseFloat(document.getElementById('mb-res').value) || 0;
  
  const totalOut = gas + lvgo + hvgo + slop + res;
  const diff = totalOut - feed;
  const errPct = feed > 0 ? (diff / feed) * 100 : 0;
  const absErr = Math.abs(errPct);
  
  let status, color;
  if(absErr < 1) { status = '✅ EXCELLENT'; color = '#2ecc71'; }
  else if(absErr < 2) { status = '✓ ACCEPTABLE'; color = '#7ecf3a'; }
  else if(absErr < 5) { status = '⚠ MARGINAL'; color = '#f59e0b'; }
  else { status = '❌ POOR — Check measurements'; color = '#e74c3c'; }
  
  document.getElementById('mb-result').innerHTML = 
    '<div class="calc-result-title">BALANCE RESULTS</div>' +
    '<div class="calc-row"><span>Total IN:</span><b>' + feed.toLocaleString() + ' bbl/d</b></div>' +
    '<div class="calc-row"><span>Total OUT:</span><b>' + totalOut.toLocaleString() + ' bbl/d</b></div>' +
    '<div class="calc-row"><span>Difference:</span><b>' + (diff > 0 ? '+' : '') + diff.toLocaleString() + ' bbl/d</b></div>' +
    '<div class="calc-row"><span>Error:</span><b style="color:' + color + ';">' + errPct.toFixed(2) + '%</b></div>' +
    '<div class="calc-result-status" style="background:rgba(' + (absErr<2?'46,204,113':'231,76,60') + ',.1);color:' + color + ';">' + status + '</div>' +
    '<div class="calc-note">📝 Industry standard: ±2% closure. Larger errors indicate flow meter calibration issues or unaccounted streams.</div>';
}

