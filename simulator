function scoreSopStep(success){
  window._score.procedure.sopAttempted++;
  if(success){
    window._score.procedure.sopFollowed++;
    window._score.procedure.score = 
      (window._score.procedure.sopFollowed / window._score.procedure.sopAttempted) * 100;
    const t = Math.floor((Date.now() - window._score.startTime) / 1000);
    window._score.events.push({t, type: 'sop', msg: '✓ SOP step completed correctly'});
  } else {
    window._score.procedure.score = Math.max(0, window._score.procedure.score - 10);
  }
}

function getScoreGrade(score){
  if(score >= 90) return {grade: 'A', label: 'EXCELLENT', color: '#2ecc71'};
  if(score >= 80) return {grade: 'B', label: 'GOOD', color: '#7ecf3a'};
  if(score >= 70) return {grade: 'C', label: 'AVERAGE', color: '#f59e0b'};
  if(score >= 60) return {grade: 'D', label: 'NEEDS IMPROVEMENT', color: '#ff8050'};
  return {grade: 'F', label: 'FAILED', color: '#e74c3c'};
}

