// ═══════════ SIMULATION ═══════════
// ═══════════════════════════════════════════════════════════════
// DYNAMIC STATE SYSTEM — Time-based response (first-order lag)
// ═══════════════════════════════════════════════════════════════
// Real refinery dynamics:
//   - Tower temp changes: τ = 3-5 min
//   - HE outlet temp: τ = 30-90 sec  
//   - Pressure changes: τ = 10-30 sec
//   - Level changes: τ = 5-15 min
//
// First-order lag formula:
//   actual(t+dt) = actual(t) + (target - actual(t)) × (1 - exp(-dt/τ))
//
// At each sim() tick (1 sec), state values move toward their targets
// at a rate determined by τ (time constant)
// ═══════════════════════════════════════════════════════════════

window._dyn = window._dyn || {
  // Tower
  T_top:    {actual: 85,  target: 85,  tau: 180},  // 3 min
  T_LLO:    {actual: 165, target: 165, tau: 240},  // 4 min
  T_HLO:    {actual: 275, target: 275, tau: 240},  // 4 min
  T_flash:  {actual: 383, target: 383, tau: 60},   // 1 min (close to furnace)
  T_res_in: {actual: 370, target: 370, tau: 120},  // 2 min
  T_slop:   {actual: 320, target: 320, tau: 240},  // 4 min
  
  // HE outlets (faster — smaller thermal mass)
  lv2T: {actual: 75, target: 75, tau: 60},
  lv3T: {actual: 50, target: 50, tau: 45},
  hv2T: {actual: 95, target: 95, tau: 60},
  hv3T: {actual: 50, target: 50, tau: 45},
  oh1T: {actual: 80, target: 80, tau: 30},
  oh2T: {actual: 65, target: 65, tau: 30},
  oh3T: {actual: 50, target: 50, tau: 30},
  rsOut:    {actual: 165, target: 165, tau: 90},
  T_slop_out: {actual: 150, target: 150, tau: 75},
  
  // Furnace metal mass (slow — large refractory + tubes)
  furnace_T: {actual: 405, target: 405, tau: 600},  // 10 min cooldown
};

// Apply first-order lag — call once per sim tick
function dynStep(dt_sec){
  for(const key in window._dyn){
    const s = window._dyn[key];
    const alpha = 1 - Math.exp(-dt_sec / s.tau);
    s.actual = s.actual + (s.target - s.actual) * alpha;
  }
}

// Get current actual value
function dynGet(key){
  return window._dyn[key] ? window._dyn[key].actual : 0;
}

// Set target value (sim() will compute these each tick)
function dynSet(key, target){
  if(window._dyn[key]) window._dyn[key].target = target;
}

// Snap to target instantly (for SOP step changes)
function dynSnap(key, value){
  if(window._dyn[key]){
    window._dyn[key].actual = value;
    window._dyn[key].target = value;
  }
}

function sim(){
  try {
  // Safe slider reads with defaults
  const T = getVal('sl-temp', 405);
  const P_bar = getVal('sl-press', -0.933);
  const P_abs_mmhg = Math.round((1.01325 + P_bar) * 750.06);
  const P = P_abs_mmhg;
  const S = getVal('sl-steam', 15);
  const F=+document.getElementById('sl-feed').value;
  const ox1=+document.getElementById('sl-ox1').value;
  const ox2=+document.getElementById('sl-ox2').value;
  const ox3=+document.getElementById('sl-ox3').value;
  // Pump discharge pressures (read for display + physics)
  const p101d=+document.getElementById('sl-p101').value;
  const p102d=+document.getElementById('sl-p102').value;
  const p103d=+document.getElementById('sl-p103').value;
  const p104d=+document.getElementById('sl-p104').value;
  const p105d=+document.getElementById('sl-p105').value;
  const boilP=+document.getElementById('sl-boiler').value;
  const hboilT=+document.getElementById('sl-hboil').value;
  const p101=+document.getElementById('sl-p101').value;
  const p102=+document.getElementById('sl-p102').value;
  const p103=+document.getElementById('sl-p103').value;
  const p104=+document.getElementById('sl-p104').value;
  const p105=+document.getElementById('sl-p105').value;

  // slider labels
  set('v-temp',T+'°C');
  // Display: negative bar with mmHg abs in parentheses
  set('v-press', P_bar.toFixed(3)+' bar ('+P_abs_mmhg+' mmHg abs)');
  set('v-steam',S+' t/h');
  set('v-feed',F.toLocaleString()+' bbl/d');
  set('v-p101',p101d.toFixed(1)+' barg');set('v-p102',p102d.toFixed(1)+' barg');
  set('v-p103',p103d.toFixed(1)+' barg');set('v-p104',p104d.toFixed(1)+' barg');set('v-p105',p105d.toFixed(1)+' barg');
  set('v-ox1',ox1.toFixed(2)+' barg');set('v-ox2',ox2.toFixed(2)+' barg');set('v-ox3',ox3.toFixed(2)+' barg');
  // ox display handled above
  set('v-boiler',boilP+' bar');set('v-hboil',hboilT+'°C');

  // ════════════════════════════════════════════════════════════════
  //  DYNAMIC SIMULATION ENGINE v2  —  Physics-based model
  //  Engineer: Mustafa Naji Abdullah  |  © 2026
  // ════════════════════════════════════════════════════════════════

  // ── Helper ────────────────────────────────────────────────────
  const clamp = (mn,mx,v) => Math.max(mn,Math.min(mx,v));

  // ── 1. INPUT STATE (with fault overrides) ─────────────────────
  const sm = {'low':.4,'med':1.0,'high':1.9}[severity];
  let Fm=F, Pm=P, Tm=T, qm=1.0, lvm=0;
  for(const fid of activeFaults){
    const fi=FDB[fid]; if(!fi) continue;
    if(fi.impact.feed)  Fm = Math.max(1000, Fm*(1+fi.impact.feed*sm));
    if(fi.impact.press) Pm = Math.min(700,  Pm+fi.impact.press*sm);
    if(fi.impact.temp)  Tm = Math.min(445,  Tm+fi.impact.temp*sm);
    if(fi.impact.prodQ) qm = Math.max(0.15, qm+fi.impact.prodQ*sm);
    if(fi.impact.level) lvm += fi.impact.level*sm;
  }
  // ─── Special-handling new faults ───
  if(activeFaults.has('feed-loss'))     Fm = Math.max(0, Fm * 0.05);    // 95% feed loss
  if(activeFaults.has('feed-contam'))   { Fm = Fm * 0.7; Pm += 15; }     // wet feed → vapor surge
  if(activeFaults.has('tube-rupture'))  { Tm = 250; Fm = Fm * 0.3; }     // emergency cooldown
  if(activeFaults.has('burner-flameout'))Tm = Math.max(180, Tm - 80);    // big temp drop
  if(activeFaults.has('cw-loss'))       qm = qm * 0.55;                  // major quality loss
  if(activeFaults.has('flooding'))      qm = qm * 0.65;
  if(activeFaults.has('coking'))        Tm = Math.min(425, Tm + 18);
  // Vacuum system faults (inline to avoid TDZ)
  const _ej1 = activeFaults.has('ej1-trip') ? 25 : 0;
  const _ej2 = activeFaults.has('ej2-trip') ? 35 : 0;
  const _air = activeFaults.has('air-ingress') ? 20 : 0;
  Pm = Math.min(700, Pm + _ej1 + _ej2 + _air);                           // ejector trips/leaks

  // ── 2. PRESSURE PHYSICS ────────────────────────────────────────
  // Pm = mmHg absolute (e.g. 50 mmHg = normal VDT)
  // Bubble point shift: each 10 mmHg above baseline raises boiling ~2.5°C
  const P_baseline = 50;                          // mmHg abs — design point
  const T_bubble_base = 318;                      // °C at baseline vacuum
  const T_bubble = T_bubble_base + (Pm - P_baseline) * 0.25;
  // Vacuum quality factor: 1.0 = perfect, 0 = no vacuum
  const pf = clamp(0, 1, 1 - (Pm - P_baseline) / 550);

  // ── 3. VAPORIZATION FRACTION (V/F) ─────────────────────────────
  // How much of feed vaporizes at Flash Zone
  // V/F rises with: higher T_feed, lower pressure, more steam
  const sf = clamp(0, 1, S / 25);                // steam contribution
  const VF = clamp(0.15, 0.88,
    0.38
    + (Tm - 380) * 0.009      // furnace temp effect (+1% per 1°C above 380)
    - (Pm - P_baseline)*0.0012 // vacuum effect (worse vacuum = less V/F)
    + sf * 0.06                 // steam stripping boost
  );

  // ── 4. SEPARATION SHARPNESS ────────────────────────────────────
  // Reflux ratio from P-105 pressure (proxy for reflux flow)
  const reflux_proxy = clamp(0, 1, p105d / 3.5);
  // Tray efficiency: affected by flooding (high V/F), vacuum quality
  const tray_eff = clamp(0.3, 0.92,
    0.72
    + pf * 0.12                // better vacuum = better tray efficiency
    + reflux_proxy * 0.08      // more reflux = better separation
    - Math.max(0, VF-0.7)*0.4  // flooding penalty at high V/F
  );
  const separation = tray_eff * qm;

  // ── 5. PRODUCT YIELDS (% of feed) ─────────────────────────────
  // Based on V/F and separation sharpness
  const fk = Fm / 50000;                          // feed scaling factor

  // Gas: light ends, increases with T and decreases with reflux
  const gas_frac = clamp(0.01, 0.08,
    0.025 + (Tm-380)*0.0004 - reflux_proxy*0.005
  );
  // LLO: light vacuum gas oil — needs good vacuum AND good separation
  const LLO_frac = clamp(0.08, 0.35,
    0.22 * VF * separation * (1 + pf*0.2)
  );
  // HLO: heavy vacuum gas oil — main product
  const HLO_frac = clamp(0.15, 0.42,
    0.36 * VF * separation * (1 + sf*0.05)
  );
  // Slop: poor separation cut — increases when sep is bad
  const slop_frac = clamp(0.02, 0.15,
    0.05 + (1-separation)*0.08 + (Pm-P_baseline)*0.0002
  );
  // Residue: everything that didn't vaporize
  const res_frac = clamp(0.15, 0.65,
    1.0 - gas_frac - LLO_frac - HLO_frac - slop_frac
  );

  // Convert fractions to actual flow rates
  const gasV  = Math.round(fk * gas_frac  * 3200 / 10) * 10;   // t/d
  const lvgo  = Math.round(fk * LLO_frac  * 50000 / 100) * 100; // bbl/d
  const hvgo  = Math.round(fk * HLO_frac  * 50000 / 100) * 100;
  const slop  = Math.round(fk * slop_frac * 50000 / 100) * 100;
  const res   = Math.max(2000, Math.round(fk * res_frac * 50000 / 100) * 100);
  const lv_base = lvgo;
  const hl_base = hvgo;

  // ══════════════════════════════════════════════════════════════
  // ── 6. TEMPERATURE PROFILE — REAL VDU PHYSICS ──────────────────
  // ══════════════════════════════════════════════════════════════
  // Sources: OGJ (Lieberman), DigitalRefining, Cheresources field data
  //
  // KEY INSIGHT: In a real VDU, three heat-removal streams control
  //   tower temperatures — NOT just top reflux:
  //
  //   (1) Top Reflux (P-105 from SEP-101) — minor cooling effect
  //   (2) LLO Pumparound — DOMINANT cooling for top + LLO section
  //   (3) HLO Pumparound — DOMINANT cooling for HLO section
  //
  // Pumparound removes heat by: hot draw → cooler → cold return
  // Real refinery duties:
  //   LLO P/A: 40-80 MMBTU/hr  (ΔT ≈ 125°C across cooler)
  //   HLO P/A: 80-120 MMBTU/hr (ΔT ≈ 130°C across cooler)
  //
  // Pumparound rate (% of design) directly affects section temp.
  // ══════════════════════════════════════════════════════════════

  // ══════════════════════════════════════════════════════════════
  // ── 6. TEMPERATURE PROFILE — INDUSTRY VALIDATED PHYSICS ─────────
  // ══════════════════════════════════════════════════════════════
  // SOURCES:
  //   - OGJ 1992 (Lieberman): LVGO P/A ~85 MMBTU/hr, HVGO P/A ~82 MMBTU/hr
  //   - ABB VDU Module 2: HVGO draw 275°C (527°F)
  //   - University of Oklahoma Petroleum Guide: HVGO draw 90-120°C above LVGO
  //   - Cheresources: T_top max 500°F (260°C), reflux >=300°F (149°C)
  //   - ScienceDirect 2024: Furnace COT 380-420°C, transfer line ΔT 10-15°C
  //   - Hydrocarbon Processing 2025: Tower top 10-20 mmHg abs typical
  //   - Lieberman pumparound chapter: P/A return 100°F (55°C) below draw
  
  // Read pumparound rates (% of design flow)
  const llopa = +document.getElementById('sl-llopa').value / 100;
  const hlopa = +document.getElementById('sl-hlopa').value / 100;
  
  // ─── Helper fault factors (used in HE eps calculations below) ───
  const cw_loss_factor = activeFaults.has('cw-loss') ? 0.5 : 1.0;       // 50% reduction
  const CW_T_effective = 36 + (activeFaults.has('cw-hot') ? 12 : 0);
  
  // ─── (a) T_TOP: Clausius-Clapeyron + Reflux + LLO P/A ───
  // Industry standard: T_top typically 80-150°C at 10-20 mmHg
  // At atmospheric, hydrocarbon dewpoint ~165°C (light naphtha range)
  const T_atm_dewpoint = 165;
  const P_ratio = Math.max(0.001, Math.min(1, Pm/760));
  const T_dew_at_P = T_atm_dewpoint * Math.pow(P_ratio, 0.13);
  
  // Cooling per OGJ 1992 plant data:
  //   LVGO P/A duty ~85 MMBTU/hr → cools T_top by ~45°C at full design
  //   Top reflux only ~5-10% as effective as P/A
  const top_reflux_cool = reflux_proxy * 8;        // industry: smaller effect       // ~12°C at full reflux
  const llopa_cool_top = llopa * 28;               // tuned to industry T_top 95-130°C range
  
  // ─── DYNAMIC RESPONSE — values lag toward target ───
  // Compute target values from physics, then state system smoothly approaches them
  
  const T_top_target = clamp(80, 260,
    T_dew_at_P
    + (Tm-405) * 0.04
    - top_reflux_cool
    - llopa_cool_top
    + (activeFaults.has('fault-p105') ? 22 : 0)
  );
  dynSet('T_top', T_top_target);
  const T_top = dynGet('T_top');
  
  // Flash zone — closer to furnace, faster response
  const T_flash_target = clamp(340, 425, Tm - 12);
  dynSet('T_flash', T_flash_target);
  const T_flash = dynGet('T_flash');
  
  // ─── (c) DRAW TEMPERATURES — DYNAMIC ───
  const T_LLO_base = T_top + (T_flash - T_top) * 0.32;
  const T_LLO_target = clamp(120, 280,
    T_LLO_base
    - llopa * 18
    + (1-pf) * 6
    + (activeFaults.has('fault-p101') ? 35 : 0)
  );
  dynSet('T_LLO', T_LLO_target);
  const T_LLO_draw = dynGet('T_LLO');
  
  const T_HLO_base = T_top + (T_flash - T_top) * 0.72;
  const T_HLO_target = clamp(200, 360,
    T_HLO_base
    - hlopa * 30
    + (1-pf) * 10
    + (activeFaults.has('fault-p102') ? 42 : 0)
  );
  dynSet('T_HLO', T_HLO_target);
  const T_HLO_draw = dynGet('T_HLO');
  
  // ══════════════════════════════════════════════════════════════
  // ── 7. HEAT EXCHANGER OUTLETS — Heat Transfer Physics ──────────
  // ══════════════════════════════════════════════════════════════

  // ══════════════════════════════════════════════════════════════
  // ── 7. HEAT EXCHANGER OUTLETS — Heat Transfer Physics ──────────
  // ══════════════════════════════════════════════════════════════
  // T_out = T_in − ε × (T_in − T_CW)   (ε = effectiveness 0..1)
  
  const CW_T = 36;
  
  // Effectiveness factors
  const eps_HE101  = 0.78 - (activeFaults.has('leak-he101')  ? 0.10 : 0);
  const eps_HE102  = 0.74 - (activeFaults.has('foul-he102')  ? 0.42 : 0);
  const eps_HE102B = 0.68 - (activeFaults.has('foul-he102b') ? 0.32 : 0);
  const eps_HE107  = 0.72 - (activeFaults.has('leak-he107')  ? 0.10 : 0);
  const eps_HE104  = 0.65;
  
  // ──────────────────────────────────────────────────────────────
  // GENERIC TIC-CONTROLLED HEAT EXCHANGER MODEL
  // 
  // DISCHARGE VALVE EFFECT (gradual, realistic limits):
  // As valve closes more → flow ↓ → residence time ↑ → outlet drops
  // 
  // BUT: The drop is LIMITED to ~20-25°C below setpoint
  // Why? CW flow is constant; HE has finite UA; even at zero flow
  // the metal mass keeps a temperature gradient.
  // 
  //   flow_ratio = 1.0 (valve fully open)  → outlet at setpoint
  //   flow_ratio = 0.5 (half open)         → outlet ~10°C below setpoint
  //   flow_ratio = 0.2 (mostly closed)     → outlet ~18°C below setpoint
  //   flow_ratio = 0.05 (near zero)        → outlet ~22°C below setpoint (max)
  //   flow_ratio = 0.0 (closed/no flow)    → outlet stays at last value (no flow = no measurement)
  // ──────────────────────────────────────────────────────────────
  function ticHE(T_in, setpoint, eps_max, drift, fault_offset, flow_ratio){
    const fr = Math.max(0, Math.min(1, flow_ratio));
    
    // Physical floor: at zero flow, outlet approaches CW temp (full equilibrium)
    // At full flow, outlet at TIC setpoint (or limited by eps_max)
    const out_full_flow_min = T_in - eps_max * (T_in - CW_T);   // bypass fully open at design flow
    const out_zero_flow_min = CW_T + 4;                         // near CW at stagnation
    const out_max = T_in - 4;                                   // small ΔT minimum
    
    // If inlet is COLDER than setpoint, can't reach setpoint
    if (T_in < setpoint) {
      // Inlet already cooler than target — minimal further cooling
      let out = T_in - 2;
      const extra = (1 - fr) * 5;  // up to 5°C extra at zero flow
      out -= extra;
      return Math.max(CW_T + 2, out + fault_offset);
    }
    
    // Normal case: T_in > setpoint
    // TIC tries to hit setpoint at design flow
    // At lower flow, residence time is longer → MORE cooling (outlet drops)
    // At zero flow, outlet → near CW temp
    
    let out_tic;
    if(setpoint < out_full_flow_min)   out_tic = out_full_flow_min;
    else if(setpoint > out_max)        out_tic = out_max;
    else                               out_tic = setpoint + (T_in - (out_full_flow_min+out_max)/2) * drift;
    
    // Residence time effect: at zero flow, outlet pulled toward CW
    // Linear interpolation: high flow → out_tic, low flow → near CW
    const target_low_flow = Math.max(CW_T + 4, out_full_flow_min - 25);  // can drop ~25°C below normal min
    
    // Smooth blend between out_tic (high flow) and target_low_flow (zero flow)
    const blend = Math.pow(1 - fr, 0.6);  // 0 at full flow, 1 at zero flow
    let out = out_tic * (1 - blend) + target_low_flow * blend;
    
    // Hard ceiling: cannot exceed inlet
    out = Math.min(out, T_in - 2);
    out = Math.max(out, CW_T + 2);
    
    return out + fault_offset;
  }
  
  // Calculate flow ratios from pump pressures
  const p101_fr = Math.max(0, Math.min(1, p101d / 4.0));
  const p102_fr = Math.max(0, Math.min(1, p102d / 5.0));
  const p103_fr = Math.max(0, Math.min(1, p103d / 6.0));
  const p104_fr = Math.max(0, Math.min(1, p104d / 0.50));
  const p105_fr = Math.max(0, Math.min(1, p105d / 2.5));
  
  const p101_off = p101_fr < 0.05;
  const p102_off = p102_fr < 0.05;
  const p103_off = p103_fr < 0.05;
  const p104_off = p104_fr < 0.05;
  const p105_off = p105_fr < 0.05;
  
  // ─── HE-101 LLO Cooler (1st stage) — TIC setpoint 75°C ───
  const lv1T = T_LLO_draw;
  const lv2T_raw = ticHE(lv1T, 75, eps_HE101, 0.25,
    (activeFaults.has('leak-he101') ? -8 : 0), p101_fr);
  const lv2T = clamp(CW_T+2, 130, lv2T_raw);
  
  // ─── HE-101B LLO Trim Cooler (2nd stage) — TIC setpoint 50°C ───
  const eps_HE101B = 0.65 - (activeFaults.has('foul-he101b') ? 0.30 : 0);
  const lv3T_raw = ticHE(lv2T, 50, eps_HE101B, 0.18, 0, p101_fr);
  const lv3T = clamp(CW_T+2, 80, lv3T_raw);
  
  // ─── HE-102 HLO Cooler (1st stage) — TIC setpoint 85°C ───
  const hv1T = T_HLO_draw;
  const hv2T_raw = ticHE(hv1T, 85, eps_HE102, 0.25,
    (activeFaults.has('foul-he102') ? 25 : 0), p102_fr);
  const hv2T = clamp(CW_T+2, 160, hv2T_raw);
  
  // ─── HE-102B HLO Trim Cooler (2nd stage) — TIC setpoint 50°C ───
  const hv3T_raw = ticHE(hv2T, 50, eps_HE102B, 0.18,
    (activeFaults.has('foul-he102b') ? 12 : 0), p102_fr);
  const hv3T = clamp(CW_T+2, 95, hv3T_raw);
  
  // ─── OVERHEAD PATH ───
  // HE-106 now acts as feed pre-heater: feed flow rate affects cooling
  // Higher feed → more heat absorbed → overhead cools more efficiently
  const feed_fr = Math.max(0.2, Math.min(1.2, F / 50000));  // feed flow ratio (design = 50000 bbl/d)
  const oh0T = T_top;
  const eps_HE106 = 0.48 - (activeFaults.has('leak-he106') ? 0.22 : 0);
  const oh1T_raw = ticHE(oh0T, 80, eps_HE106, 0.25, 0, feed_fr);
  const oh1T = clamp(70, 180, oh1T_raw);
  
  // HE-103A & HE-103B: overhead vapor flow is driven by tower load + reflux pump
  // Combine influences: feed flow (vapor production) + p105 (reflux affects vapor return)
  const overhead_fr = Math.max(0.2, Math.min(1.2, (feed_fr + p105_fr) / 2));
  
  const eps_HE103A = 0.62 - (activeFaults.has('leak-he103a') ? 0.25 : 0);
  const oh2T_raw = ticHE(oh1T, 60, eps_HE103A, 0.25, 0, overhead_fr);
  const oh2T = clamp(45, 130, oh2T_raw);
  
  const eps_HE103B = 0.55 - (activeFaults.has('leak-he103b') ? 0.22 : 0);
  const oh3T_raw = ticHE(oh2T, 45, eps_HE103B, 0.20, 0, overhead_fr);
  const oh3T = clamp(CW_T+2, 95, oh3T_raw);
  
  // ─── SLOP WAX ───
  const T_slop_draw = clamp(285, 380,
    T_top + (T_flash - T_top) * 0.85
    - hlopa * 12
    + (Pm-P_baseline) * 0.04
  );
  const T_slop_out_raw = ticHE(T_slop_draw, 150, eps_HE107, 0.22,
    (activeFaults.has('leak-he107') ? -10 : 0), p103_fr);
  const T_slop_out = clamp(115, 250, T_slop_out_raw);
  
  // ─── VACUUM RESIDUE ───
  // T_res_in: from tower bottom, depends on stripping steam + flash zone
  const T_res_in = clamp(320, 400,
    T_flash - 12 - sf * 6                                   // steam strips & cools
  );
  
  // ─── HE-104 RESIDUE COOLER — gradual valve effect ───
  const TIC_setpoint = 165;
  const eps_max_104 = 0.62;
  
  let rsOut_calc;
  if (T_res_in < TIC_setpoint) {
    rsOut_calc = T_res_in - 2 - (1 - p104_fr) * 5;
  } else {
    const rsOut_full_flow_min = T_res_in - eps_max_104 * (T_res_in - CW_T);
    const rsOut_max_val = T_res_in - 5;
    
    let rsOut_tic;
    if(TIC_setpoint < rsOut_full_flow_min) rsOut_tic = rsOut_full_flow_min;
    else if(TIC_setpoint > rsOut_max_val) rsOut_tic = rsOut_max_val;
    else rsOut_tic = TIC_setpoint + (T_res_in - 365) * 0.18;
    
    // At zero flow, residue can drop near CW (but never below pour point in real plants)
    const target_low_flow_104 = Math.max(CW_T + 4, rsOut_full_flow_min - 25);
    const blend = Math.pow(1 - p104_fr, 0.6);
    rsOut_calc = rsOut_tic * (1 - blend) + target_low_flow_104 * blend;
    rsOut_calc = Math.min(rsOut_calc, T_res_in - 2);
  }
  
  if (activeFaults.has('leak-he104')) rsOut_calc -= 10;
  const rsOut = clamp(45, 230, rsOut_calc);  // allow lower for stagnation alarms

  // ══════════════════════════════════════════════════════════════
  // ── 7B. PUMP FLOWS — Real pump curve physics (BEFORE level) ────
  // ══════════════════════════════════════════════════════════════
  // CENTRIFUGAL pump curve: H = H_shutoff − k·Q²
  // Rearranged: Q ∝ √((H_shutoff − H_actual) / k)
  // Slider = discharge valve opening proxy → translates to actual head
  // 
  // For our model: opening valve more = lower head = more flow
  // We invert the slider effect:
  //   p_slider = current discharge pressure (after valve)
  //   higher slider → wider open valve → MORE FLOW (counter-intuitive but real!)
  //
  // GEAR pumps (P-103, P-104): nearly constant flow regardless of P
  
  // P-101 LLO (centrifugal): rated 4.0 barg @ 100% flow, shutoff 6 barg
  // Higher discharge slider = wider open = more flow
  const p101_flow = Math.round(lvgo * Math.sqrt(Math.max(0.05, p101d / 4.0)));
  
  // P-102 HLO (centrifugal): rated 5.0 barg, shutoff 8 barg
  const p102_flow = Math.round(hvgo * Math.sqrt(Math.max(0.05, p102d / 5.0)));
  
  // P-103 Slop (gear): constant flow regardless of P
  const p103_flow = Math.round(slop * 0.72);
  
  // P-104 Residue (gear/screw): nearly constant flow above min, but valve closure affects it
  // At p104d=0 → valve closed → no flow
  // At p104d=0.4 → balanced flow (matches Q_in)
  // At p104d=0.8 → max flow (200% of balanced)
  // Linear behavior for gear pump
  const p104_flow = Math.round(res * 0.88 * Math.min(1.5, p104d / 0.4));
  
  // P-105 Reflux (centrifugal): rated 2.5 barg, shutoff 5 barg
  const p105_flow_m3h = Math.round(600 * Math.sqrt(Math.max(0.05, p105d / 2.5)));

  // ══════════════════════════════════════════════════════════════
  // ── 8. TOWER LEVEL — REALISTIC DYNAMIC MASS BALANCE ────────────
  // ══════════════════════════════════════════════════════════════
  // Real VDT bottom level has BIG VOLUME (~80-150 m³)
  // Time constant: τ ≈ 8-15 minutes for 50% level change at full mismatch
  //
  // dV/dt = Q_in − Q_out
  // dL/dt (%/sec) = (Q_in − Q_out) / V_tank × 100
  //
  // For our sim running at 1Hz:
  // ΔL_per_tick = (Q_in − Q_out) / V_tank × 100 × dt
  //   where dt = simulation tick (~1 sec)
  //   V_tank ≈ 100 m³  (realistic VDT bottom)
  //   Q_in_residue = res * 0.85 bbl/d → m³/sec conversion
  //
  // 1 bbl = 0.159 m³, so res in bbl/d = res × 0.159 / 86400 m³/sec
  //
  // For res = 12000 bbl/d: Q_in ≈ 12000 × 0.159 / 86400 ≈ 0.022 m³/sec
  // If Q_out = 0 (P-104 stopped): ΔL/sec = 0.022/100 × 100 = 0.022%/sec
  // → 1% per 45 seconds
  // → 100% drop or rise takes ~75 minutes (very realistic!)
  
  // Initialize persistent level if not exists
  if(typeof window._towerLevel === 'undefined'){
    window._towerLevel = 50;  // start at 50%
  }
  
  const Q_in_residue_bbl = res * 0.85;                    // bbl/d residue produced
  const Q_out_p104_bbl   = p104_flow;                     // P-104 actual flow
  const flow_diff_bbl    = Q_in_residue_bbl - Q_out_p104_bbl;  // bbl/d net
  
  // Convert to %/sec — using SCALED tank volume for visible dynamics
  // Real V_tank = 629 bbl gives ~75 min for 100% change
  // For training simulator: scale down to ~5-8 min for visible feedback
  const V_tank_bbl = 100;  // scaled for simulator visibility
  const dL_per_sec = (flow_diff_bbl / 86400) / V_tank_bbl * 100;
  
  // Integrate over 1 second (each sim() call triggered by tick())
  window._towerLevel += dL_per_sec * 1.0;
  
  // Apply fault overrides (instant if fault triggers)
  if(activeFaults.has('fault-p104')) window._towerLevel = Math.min(95, window._towerLevel + 0.3);
  
  // Bound the level
  window._towerLevel = clamp(2, 98, window._towerLevel);
  
  const lvl = Math.round(window._towerLevel);

  // ══════════════════════════════════════════════════════════════
  // ── 9. SEP-101 LEVEL — MASS BALANCE ────────────────────────────
  // ══════════════════════════════════════════════════════════════
  // Q_in_sep  = condensation rate (depends on overhead T & CW effectiveness)
  // Q_out_sep = P-105 reflux pump flow
  //
  // P-105 centrifugal: opening discharge widely → flow ↑ → level drops
  
  const Q_in_sep  = clamp(0, 60, (130 - oh3T) * 1.2);     // bbl/h liquid condensing
  const Q_out_sep = p105_flow_m3h * 0.15;                  // P-105 outflow proxy
  const sep_balance = Q_in_sep - Q_out_sep;
  
  const sep_level = clamp(5, 95, Math.round(
    45                                                     // setpoint
    + sep_balance * 1.2                                    // mass balance
    + (activeFaults.has('fault-p105') ? 35 : 0)            // P-105 trip → level fills
  ));
  const water_boot = clamp(5, 80, Math.round(20 + S*1.1 - pf*8));

  // ── 10. PRODUCT QUALITY SPECS ──────────────────────────────────
  // API gravity: improves with better separation and higher temp
  const apiLLO = clamp(24, 40, Math.round(30 + pf*5 + separation*3));
  const apiHLO = clamp(15, 28, Math.round(20 + pf*3 + separation*2));
  // CCR: Conradson Carbon Residue — worsens with poor separation
  const CCR_HLO = clamp(0.3, 2.5, (0.7 + (1-separation)*1.2).toFixed(1));
  // Viscosity: decreases with higher temp, increases with poor vacuum
  const vis_LLO = clamp(3.0, 9.0, (4.2 + (1-pf)*1.5 - separation*0.8).toFixed(1));
  const vis_HLO = clamp(5.5, 18.0,(7.8 + (1-pf)*4.0 + (1-separation)*2.5).toFixed(1));
  const vis_RES = clamp(280, 680, Math.round(440 + (1-pf)*80 + (1-separation)*60));

  // ─────────────────────────────────────────────────────────────
  //  WRITE TO DISPLAY
  // ─────────────────────────────────────────────────────────────
  set('pr-gas',  gasV.toLocaleString()+' t/d');
  set('pr-lvgo', lvgo.toLocaleString()+' bbl/d');
  set('pr-hvgo', hvgo.toLocaleString()+' bbl/d');
  set('pr-slop', slop.toLocaleString()+' bbl/d');
  set('pr-res',  res.toLocaleString()+' bbl/d');
  const asp = Math.round(res*.3/100)*100;
  set('pr-asp',  asp.toLocaleString()+' bbl/d');

  // Tower instruments
  const Pm_bar   = (Pm / 750.06 - 1.01325).toFixed(3);
  const Pm_mmhg  = Math.round(Pm);
  set('lbl-tpress', Pm_bar+' bar');
  set('lbl-pi', Pm_bar);
  set('lbl-ftemp', Tm.toFixed(0)+'°C');
  set('lbl-li', lvl+'%');

  // TI readings
  set('ti-f0','160°C'); set('ti001','160°C');
  // ══════════════════════════════════════════════════════════════
  // ── FEED/EFFLUENT HEAT INTEGRATION (HE-105 train) ──────────────
  // ══════════════════════════════════════════════════════════════
  // In real refineries, product streams pre-heat the cold feed:
  //   • Cold feed (~150°C) enters HE-105 train
  //   • Hot residue (~365°C) gives up heat → exits at ~200°C
  //   • Hot HLO (~290°C) gives up heat → exits at ~130°C
  //   • Hot LLO (~175°C) gives up heat → exits at ~90°C
  //   • Pre-heated feed exits at ~270-285°C → enters furnace
  //
  // ENERGY BALANCE: Q_gained_by_feed = Q_lost_by_products
  //   m_feed × Cp × ΔT_feed = Σ(m_product × Cp × ΔT_product)
  //
  // PUMP STOP EFFECT: If pump downstream stops, NO flow → NO heat exchange!
  //   → That product can't preheat feed
  //   → Furnace works harder OR feed enters cooler
  // ══════════════════════════════════════════════════════════════
  
  const T_feed_inlet = 150;   // °C — feed from CDU
  
  // Heat available from each effluent (kW equivalents, simplified)
  // Residue: highest temp, biggest contribution
  const Q_avail_res = p104_off ? 0 : (T_res_in - 200) * (p104_flow/50000) * 9;
  // HLO: medium temp
  const Q_avail_hlo = p102_off ? 0 : (T_HLO_draw - 130) * (p102_flow/50000) * 6;
  // LLO: lowest temp, smallest contribution
  const Q_avail_llo = p101_off ? 0 : (T_LLO_draw - 90) * (p101_flow/50000) * 3;
  
  // Total preheat available
  const Q_total_preheat = Q_avail_res + Q_avail_hlo + Q_avail_llo;
  
  // Feed temp rise from preheat (capped at thermodynamic max ~290°C)
  const T_preheat_rise = Math.min(150, Q_total_preheat / Math.max(0.1, fk) / 3.5);
  const T_feed_after_HE105 = clamp(T_feed_inlet, 290, T_feed_inlet + T_preheat_rise);
  
  set('ti002', T_feed_after_HE105.toFixed(0)+'°C');
  set('ti003', Tm.toFixed(0)+'°C');
  set('ti004', T_flash.toFixed(0)+'°C');
  set('ti009', oh0T.toFixed(0)+'°C');
  set('ti010', oh1T.toFixed(0)+'°C');
  set('ti011', oh2T.toFixed(0)+'°C');
  set('ti012', oh3T.toFixed(0)+'°C');
  set('ti020', T_LLO_draw.toFixed(0)+'°C');
  set('ti021', lv2T.toFixed(0)+'°C');
  set('ti022', lv3T.toFixed(0)+'°C');
  set('ti030', T_HLO_draw.toFixed(0)+'°C');
  set('ti031', hv2T.toFixed(0)+'°C');
  set('ti032', hv3T.toFixed(0)+'°C');
  set('ti040', T_slop_draw.toFixed(0)+'°C');
  set('ti041', T_slop_out.toFixed(0)+'°C');
  set('ti050', T_res_in.toFixed(0)+'°C');
  set('ti051', rsOut.toFixed(0)+'°C');

  // ─── DYNAMIC TANK TEMPERATURES ───
  // Tank temp = blend of HE outlet (incoming hot oil) + tank inertia + heating coil
  // Higher pump flow = more fresh hot oil in tank = temp moves toward HE outlet faster
  // Lower pump flow = tank holds old temp + cools toward ambient
  
  if(!window._tankT){
    window._tankT = { tk101: 45, tk102: 50, tk103: 75, tk104: 175 };
  }
  
  // Mixing rate proportional to pump flow ratio
  // At 100% flow → ~30% per step (fast mixing)
  // At 10% flow → ~3% per step (slow mixing)
  // At 0% flow → cooling toward ambient (heating coil keeps min)
  
  const mixTank = (curr, target, fr, ambient_min) => {
    const mix_rate = Math.max(0.02, fr * 0.30);  // 2% min, 30% max
    let next = curr + (target - curr) * mix_rate;
    // Cooling drift when low flow (toward ambient + heating coil minimum)
    if(fr < 0.15) next -= (next - ambient_min) * 0.05;
    return next;
  };
  
  // TK-101 (LVGO): heated by lv3T from HE-101B, fed by P-101
  window._tankT.tk101 = mixTank(window._tankT.tk101, lv3T, p101_fr, 40);
  // TK-102 (HVGO): heated by hv3T, fed by P-102
  window._tankT.tk102 = mixTank(window._tankT.tk102, hv3T, p102_fr, 40);
  // TK-103 (Slop wax): MUST stay above 65°C, fed by P-103, ambient is heating coil
  window._tankT.tk103 = mixTank(window._tankT.tk103, T_slop_out, p103_fr, 75);
  // TK-104 (Residue): CRITICAL — needs 160-185°C, fed by P-104, hot oil coils keep 165 min
  window._tankT.tk104 = mixTank(window._tankT.tk104, rsOut, p104_fr, 165);
  
  // Tank temps
  set('lbl-tk101', window._tankT.tk101.toFixed(0)+'°C');
  set('lbl-tk102', window._tankT.tk102.toFixed(0)+'°C');
  set('lbl-tk103', window._tankT.tk103.toFixed(0)+'°C');
