function renderStrippingCalc(){
  document.getElementById('calcContent').innerHTML = 
    '<div class="calc-section">' +
      '<div class="calc-title">💨 STEAM STRIPPING EFFECT</div>' +
      '<div class="calc-desc">Estimate effect of stripping steam on flash point and yield recovery.</div>' +
      
      '<div class="calc-grid">' +
        '<div class="calc-input-row"><label>Feed (bbl/d):</label><input type="number" id="ss-feed" value="50000" onchange="calcStripping()"></div>' +
        '<div class="calc-input-row"><label>Steam Rate (lb/bbl feed):</label><input type="number" id="ss-rate" value="6" step="0.5" onchange="calcStripping()"></div>' +
        '<div class="calc-input-row"><label>Steam P (psig):</label><input type="number" id="ss-press" value="150" onchange="calcStripping()"></div>' +
        '<div class="calc-input-row"><label>Tower Bottom T (°C):</label><input type="number" id="ss-tbot" value="370" onchange="calcStripping()"></div>' +
      '</div>' +
      
      '<button class="calc-btn" onclick="calcStripping()">🧮 CALCULATE</button>' +
      
      '<div class="calc-result" id="ss-result"></div>' +
    '</div>';
  calcStripping();
}

function calcStripping(){
  const feed = parseFloat(document.getElementById('ss-feed').value) || 0;
  const rate = parseFloat(document.getElementById('ss-rate').value) || 0;
  const press = parseFloat(document.getElementById('ss-press').value) || 0;
  const tbot = parseFloat(document.getElementById('ss-tbot').value) || 0;
  
  const steam_lbhr = feed * rate / 24;
  const steam_tph = steam_lbhr / 2204.6;
  
  // Steam reduces partial pressure of HC, increases recovery
  // Empirical: each lb/bbl adds ~0.5-1% gas oil recovery
  const recovery_boost = rate * 0.7;
  
  // Flash point: stripping removes light ends, raises FP
  // Each lb/bbl raises FP ~3-5°C
  const fp_increase = rate * 3.5;
  
  // Estimated extra HVGO bbl/d
  const extra_hvgo = feed * (recovery_boost/100);
  
  // Steam cost ($/hr at $5/1000 lb)
  const steam_cost = steam_lbhr * 5 / 1000;
  
  let status, color;
  if(rate < 4) { status = '⚠ INSUFFICIENT — Low recovery'; color = '#f59e0b'; }
  else if(rate <= 8) { status = '✅ OPTIMAL'; color = '#2ecc71'; }
  else if(rate <= 12) { status = '⚠ HIGH — Diminishing returns'; color = '#f59e0b'; }
  else { status = '❌ EXCESSIVE — Tower flooding risk'; color = '#e74c3c'; }
  
  document.getElementById('ss-result').innerHTML = 
    '<div class="calc-result-title">STRIPPING ANALYSIS</div>' +
    '<div class="calc-row"><span>Steam flow:</span><b>' + steam_lbhr.toFixed(0) + ' lb/hr</b></div>' +
    '<div class="calc-row"><span>Steam flow:</span><b>' + steam_tph.toFixed(2) + ' t/hr</b></div>' +
    '<div class="calc-row"><span>Recovery boost:</span><b style="color:#2ecc71;">+' + recovery_boost.toFixed(1) + '% vol</b></div>' +
    '<div class="calc-row"><span>Extra HVGO:</span><b style="color:#65d9c8;">+' + extra_hvgo.toFixed(0) + ' bbl/d</b></div>' +
    '<div class="calc-row"><span>Flash point Δ:</span><b>+' + fp_increase.toFixed(0) + ' °C</b></div>' +
    '<div class="calc-row"><span>Steam cost ($/hr):</span><b>$' + steam_cost.toFixed(2) + '</b></div>' +
    '<div class="calc-result-status" style="background:rgba(0,0,0,.2);color:' + color + ';">' + status + '</div>' +
    '<div class="calc-note">📝 Industry typical: 4-8 lb steam/bbl feed. Higher rates → diminishing returns + flooding risk.</div>';
}

// ─── Load current sim values into calculator ───
function loadFromSim(calcType){
  if(calcType === 'yield'){
    setVal('yc-feed', getVal('sl-feed', 50000));
    const Pm = Math.round((1.01325 + getVal('sl-press', -0.93)) * 750.06);
    setVal('yc-vac', Pm);
    const T_flash = window._dyn && window._dyn.T_flash ? window._dyn.T_flash.actual : 383;
    setVal('yc-flash', T_flash.toFixed(0));
    calcYield();
    showToastInline('✓ Loaded current sim values');
  }
  else if(calcType === 'massbal'){
    setVal('mb-feed', getVal('sl-feed', 50000));
    // Estimate outputs from yields
    const feed = getVal('sl-feed', 50000);
    setVal('mb-gas', (feed * 0.01).toFixed(0));
    setVal('mb-lvgo', (feed * 0.085).toFixed(0));
    setVal('mb-hvgo', (feed * 0.24).toFixed(0));
    setVal('mb-slop', (feed * 0.035).toFixed(0));
    setVal('mb-res', (feed * 0.63).toFixed(0));
    calcMassBal();
    showToastInline('✓ Loaded from yields');
  }
  else if(calcType === 'energy'){
    setVal('en-feed', getVal('sl-feed', 50000));
    setVal('en-tout', getVal('sl-temp', 405));
    const ti002 = document.getElementById('ti002');
    if(ti002) setVal('en-tin', parseFloat(ti002.textContent) || 280);
    calcEnergy();
    showToastInline('✓ Loaded furnace conditions');
  }
}

