// Proactive advice — show toast when a NEW critical situation appears
function coachProactiveCheck(){
  if(!window._coachState.enabled) return;
  // Throttle: at most once every 10 seconds
  if(Date.now() - window._coachState.lastAutoAdvice < 10000) return;
  
  const advice = coachAnalyze();
  if(advice.length === 0 || advice[0].priority > 1) return;
  
  // Only show CRITICAL alerts proactively
  const top = advice[0];
  if(top.urgency === 'CRITICAL'){
    const key = top.title;
    if(!window._coachState.hintsGiven.includes(key)){
      window._coachState.hintsGiven.push(key);
      window._coachState.lastAutoAdvice = Date.now();
      showToastInline('🤖 COACH: ' + top.title + ' — Tap 💡 button for guidance');
      // Keep hints list small
      if(window._coachState.hintsGiven.length > 10){
        window._coachState.hintsGiven = window._coachState.hintsGiven.slice(-5);
      }
    }
  }
}

