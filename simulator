// Called every tick by main loop
function scoreSample(){
  if(!window._score.active) return;
  
  // ── 1. STABILITY ──
  // Sample each tracked parameter; deduct if outside normal range
  let outOfRange = 0;
  let total = 0;
  for(const id in _scoreRanges){
    const r = _scoreRanges[id];
    const v = getVal(id, NaN);
    if(isNaN(v)) continue;
    total++;
    if(v < r.min || v > r.max) outOfRange++;
  }
  if(total > 0){
    const sampleScore = ((total - outOfRange) / total) * 100;
    // Smooth EMA: gradual change
    window._score.stability.score = 
      window._score.stability.score * 0.95 + sampleScore * 0.05;
    window._score.stability.samples++;
    if(outOfRange > 0) window._score.stability.violations++;
  }
  
  // ── 2. SAFETY (critical limits) ──
  for(const id in _scoreRanges){
    const r = _scoreRanges[id];
    const v = getVal(id, NaN);
    if(isNaN(v)) continue;
    if(v <= r.critical_low || v >= r.critical_high){
      // Critical violation — heavy penalty
      window._score.safety.score = Math.max(0, window._score.safety.score - 0.5);
      window._score.safety.criticalEvents++;
      // Log if first time crossing
      const evtKey = id + '_critical';
      if(!window._score._lastEvts) window._score._lastEvts = {};
      const now = Date.now();
      if(!window._score._lastEvts[evtKey] || now - window._score._lastEvts[evtKey] > 30000){
        window._score._lastEvts[evtKey] = now;
        const t = Math.floor((now - window._score.startTime) / 1000);
        window._score.events.push({t, type: 'safety', msg: '⚠ ' + r.label + ' at critical: ' + v.toFixed(2)});
      }
    }
  }
  
  // ── 3. PRODUCTION ──
  // Feed rate × time → cumulative production
  const feed = getVal('sl-feed', 0);
  window._score.production.feedTotal += feed;
  window._score.production.feedTime++;
  // Score based on % of design (50000 bbl/d)
  if(window._score.production.feedTime > 5){
    const avgFeed = window._score.production.feedTotal / window._score.production.feedTime;
    window._score.production.score = Math.min(100, (avgFeed / 50000) * 100);
  }
  
  // ── 4. ALARM RESPONSE ──
  // Track active alarms (from activeFaults set)
  if(typeof activeFaults !== 'undefined' && activeFaults.size > 0){
    activeFaults.forEach(f => {
      if(!window._score.alarmResp.alarmsActive[f]){
        window._score.alarmResp.alarmsActive[f] = Date.now();
      }
    });
  }
  // Check cleared alarms
  for(const f in window._score.alarmResp.alarmsActive){
    if(typeof activeFaults === 'undefined' || !activeFaults.has(f)){
      const duration = (Date.now() - window._score.alarmResp.alarmsActive[f]) / 1000;
      // < 30 sec = full score, > 5 min = 50%
      const respScore = Math.max(50, 100 - (duration - 30) * 0.2);
      window._score.alarmResp.score = 
        window._score.alarmResp.score * 0.9 + respScore * 0.1;
      window._score.alarmResp.alarmsCleared++;
      delete window._score.alarmResp.alarmsActive[f];
      
      const t = Math.floor((Date.now() - window._score.startTime) / 1000);
      window._score.events.push({
        t, type: 'alarm', 
        msg: '✓ Cleared ' + f + ' in ' + duration.toFixed(0) + 's (' + respScore.toFixed(0) + ' pts)'
      });
    }
  }
  // Penalty for alarms left active too long
  for(const f in window._score.alarmResp.alarmsActive){
    const duration = (Date.now() - window._score.alarmResp.alarmsActive[f]) / 1000;
    if(duration > 120){  // 2 min threshold
      window._score.alarmResp.score = Math.max(20, window._score.alarmResp.score - 0.05);
    }
  }
  
  // ── COMPUTE TOTAL ──
  const s = window._score;
  s.totalScore = 
    s.stability.score    * s.stability.weight +
    s.alarmResp.score    * s.alarmResp.weight +
    s.production.score   * s.production.weight +
    s.safety.score       * s.safety.weight +
    s.procedure.score    * s.procedure.weight;
}

