      if(t.hi!==null&&num>t.hi){col='#e74c3c';stat='HH';cls='alarm';alarms.push(t.id+' HIGH: '+raw);}
      if(t.lo!==null&&num<t.lo){col='#e74c3c';stat='LL';cls='alarm';alarms.push(t.id+' LOW: '+raw);}
