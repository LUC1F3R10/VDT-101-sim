// ZOOM & PAN — SVG canvas
// ═══════════════════════════════════════════════════════════
let _zoomLevel = 1.5;  // start at 150%
const _zoomMin = 0.3;
const _zoomMax = 3.0;
const _zoomStep = 0.2;

function applyZoom(){
  const svg = document.getElementById('mainSvg');
  const lvl = document.getElementById('zoomLevel');
  if(svg) svg.style.transform = 'scale(' + _zoomLevel + ')';
  if(lvl) lvl.textContent = Math.round(_zoomLevel * 100) + '%';
}

function zoomIn(){
  _zoomLevel = Math.min(_zoomMax, _zoomLevel + _zoomStep);
  applyZoom();
}

function zoomOut(){
  _zoomLevel = Math.max(_zoomMin, _zoomLevel - _zoomStep);
  applyZoom();
}

function zoomReset(){
  // Default: 150% zoom for good visibility
  _zoomLevel = 1.5;
  applyZoom();
  const container = document.getElementById('svgContainer');
  if(container){
    container.scrollLeft = 0;
    container.scrollTop = 0;
  }
}

function zoomFit(){
  // Auto-fit: calculate scale to fit container
  const container = document.getElementById('svgContainer');
  if(!container) return;
  const cw = container.clientWidth;
  const ch = container.clientHeight;
  const svgW = 2600;
  const svgH = 1100;
  const fitScale = Math.min(cw / svgW, ch / svgH);
  _zoomLevel = Math.max(_zoomMin, fitScale);
  applyZoom();
  container.scrollLeft = 0;
  container.scrollTop = 0;
}

// Pinch-to-zoom support (touch)
let _touchDist = 0;
let _touchZoomStart = 1;
function getTouchDist(e){
  if(e.touches.length < 2) return 0;
  const dx = e.touches[0].clientX - e.touches[1].clientX;
  const dy = e.touches[0].clientY - e.touches[1].clientY;
  return Math.sqrt(dx*dx + dy*dy);
}

document.addEventListener('DOMContentLoaded', function(){
  const container = document.getElementById('svgContainer');
  if(!container) return;
  
  // Touch pinch-to-zoom
  container.addEventListener('touchstart', function(e){
    if(e.touches.length === 2){
      _touchDist = getTouchDist(e);
      _touchZoomStart = _zoomLevel;
      e.preventDefault();
    }
  }, {passive: false});
  
  container.addEventListener('touchmove', function(e){
    if(e.touches.length === 2 && _touchDist > 0){
      const newDist = getTouchDist(e);
      const ratio = newDist / _touchDist;
      _zoomLevel = Math.max(_zoomMin, Math.min(_zoomMax, _touchZoomStart * ratio));
      applyZoom();
      e.preventDefault();
    }
  }, {passive: false});
  
  container.addEventListener('touchend', function(){
    _touchDist = 0;
  });
  
  // Mouse wheel zoom (desktop)
  container.addEventListener('wheel', function(e){
    if(e.ctrlKey || e.metaKey){
      e.preventDefault();
      if(e.deltaY < 0) zoomIn();
      else zoomOut();
    }
  }, {passive: false});
  
  // Apply initial 150% zoom
  setTimeout(applyZoom, 100);
});

