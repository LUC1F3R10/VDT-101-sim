function updateFlushDisplay(){
  const items = ['residue','hlo','slop','llo','steam','blind'];
  items.forEach(k=>{
    const btn = document.getElementById('flush-btn-'+k);
    if(btn){
      if(flushState[k]){
        btn.style.background = 'rgba(46,204,113,.2)';
        btn.style.color = '#2ecc71';
        btn.style.borderColor = '#2ecc71';
        if(!btn.textContent.startsWith('✓')){
          btn.textContent = '✓ '+btn.textContent;
        }
      }
    }
  });
  
  const done = items.filter(k=>flushState[k]).length;
  const total = items.length;
  const status = document.getElementById('flush-status');
  if(status){
    if(done === total){
      status.style.color = '#2ecc71';
      status.style.background = 'rgba(46,204,113,.1)';
      status.style.border = '1px solid #2ecc71';
      status.innerHTML = '✓ ALL FLUSHING COMPLETE — Unit safe for maintenance';
    } else {
      status.style.color = 'var(--mut)';
      status.innerHTML = 'Progress: '+done+'/'+total+' steps complete';
    }
  }
}
function flushAction(step){
  const labels = {
    residue:'Residue line flushed with gas oil — HE-104 + P-104 clean',
    hlo:    'HLO line flushed — HE-102 + HE-102B + P-102 clean',
    slop:   'Slop Wax line flushed — HE-107 + P-103 clean',
    llo:    'LLO line flushed — HE-101 + HE-101B + P-101 clean',
    steam:  'Steam purge complete — all hydrocarbon lines clean',
    blind:  'Blinds installed per blind list — unit isolated'
  };
  
  if(flushState[step]){
    showToastInline('Already done: '+labels[step]);
    return;
  }
  
  // Sequence enforcement: must do residue first
  if(step !== 'residue' && !flushState.residue){
    showToastInline('⚠ MUST flush RESIDUE LINE FIRST! It will plug if you wait.');
    return;
  }
  
  flushState[step] = true;
  showToastInline('🧹 '+labels[step]);
  updateFlushDisplay();
}

