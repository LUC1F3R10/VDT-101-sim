  if(p105d<1.2) als.push({t:'aw',m:'⚠ P-105 reflux '+p105d.toFixed(1)+' barg — reflux dropping'});
  if(ox1>0.72) als.push({t:'ae',m:'🔴 OX-101 '+ox1.toFixed(2)+' barg — overpressure risk!'});
  if(ox2>0.72) als.push({t:'ae',m:'🔴 OX-102 '+ox2.toFixed(2)+' barg — overpressure risk!'});
  if(ox3>0.72) als.push({t:'ae',m:'🔴 OX-103 '+ox3.toFixed(2)+' barg — overpressure risk!'});
  for(const fid of activeFaults) als.push({t:'ae',m:'⚠ FAULT: '+(FDB[fid]?.title||fid)});
  if(!als.length) als.push({t:'aok',m:'✓ ALL PARAMETERS WITHIN NORMAL LIMITS'});
  document.getElementById('alerts').innerHTML = als.map(a=>`<div class="al ${a.t}">${a.m}</div>`).join('');

  // ─── FLOW SPEED ───────────────────────────────────────────────
  const spd = Math.max(0.25, 0.9 - (Fm-20000)/90000);
  document.querySelectorAll('.fr,.fl,.fu,.fd').forEach(e=>e.style.animationDuration=spd+'s');

  // ─── ROUTING VISUAL UPDATE ────────────────────────────────────
  if(typeof updateRoutingDisplay==='function') updateRoutingDisplay();

