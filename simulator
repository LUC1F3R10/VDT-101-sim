let sopCurrent=0,sopCurrentMode='startup',sopChecked={};

function sopMode(m){
  sopCurrentMode=m;sopCurrent=0;sopChecked={};
  ['start','shut','norm'].forEach(x=>{const el=document.getElementById('sop-'+x+'-btn');if(el)el.classList.remove('on');});
  const idMap={startup:'start',shutdown:'shut',normal:'norm'};
  const btn=document.getElementById('sop-'+idMap[m]+'-btn');if(btn)btn.classList.add('on');
  const titles={startup:'VDT STARTUP PROCEDURE',shutdown:'VDT SHUTDOWN PROCEDURE',normal:'NORMAL OPERATION CHECKS'};
  set('sop-title',titles[m]);
  renderSopStep();
}

function renderSopStep(){
  const steps=PROCS[sopCurrentMode];
  if(!steps)return;
  const s=steps[sopCurrent];if(!s)return;
  set('sop-cur',sopCurrent+1);set('sop-tot',steps.length);
  const barEl=document.getElementById('sop-bar');
  if(barEl)barEl.style.width=((sopCurrent+1)/steps.length*100)+'%';
  const key=sopCurrentMode+'_'+sopCurrent;
  const checked=sopChecked[key]||{};
  let checksHtml='';
  (s.checks||[]).forEach((c,i)=>{
    const done=!!checked[i];
    checksHtml+=`<div class="sop-check ${done?'done':''}" onclick="toggleSopCheck('${key}',${i})"><div class="sop-check-box">${done?'v':''}</div><div class="sop-check-txt">${c}</div></div>`;
  });
  const isLast=sopCurrent===steps.length-1;
  const allDone=(s.checks||[]).every((_,i)=>!!checked[i]);
  const sb=document.getElementById('sop-step-box');
  if(sb)sb.innerHTML=`<div class="sop-step"><div class="sop-step-num">STEP ${sopCurrent+1} / ${steps.length}</div><div class="sop-step-title">${s.title}</div><div class="sop-step-desc">${s.desc.replace(/\n/g,'<br>')}</div>${s.critical?`<div class="sop-step-crit">${s.critical}</div>`:''}${s.ok?`<div class="sop-step-ok">${s.ok}</div>`:''}</div>`;
  const ca=document.getElementById('sop-check-area');if(ca)ca.innerHTML=checksHtml;
  const nxt=document.getElementById('sop-next-btn');
  if(nxt){if(isLast&&allDone){nxt.textContent='COMPLETE';nxt.style.color='#2ecc71';nxt.style.borderColor='#2ecc71';}else{nxt.textContent='NEXT';nxt.style.color='';nxt.style.borderColor='';}}
  // Update SOP badge in topbar
  const sopBdg=document.getElementById('sop-badge');
  if(sopBdg){
    const modeLabels={startup:'STARTUP',shutdown:'SHUTDOWN',normal:'NORMAL OP'};
    sopBdg.textContent=modeLabels[sopCurrentMode]+' '+(sopCurrent+1)+'/'+steps.length;
    sopBdg.style.display='block';
  }
}
function toggleSopCheck(key,i){if(!sopChecked[key])sopChecked[key]={};sopChecked[key][i]=!sopChecked[key][i];renderSopStep();}
function sopNext(){
  const steps=PROCS[sopCurrentMode];
  if(sopCurrent<steps.length-1){
    sopCurrent++;
    if(typeof applySopAction==='function') applySopAction(sopCurrentMode+'_'+sopCurrent);
    renderSopStep();
  }
}
function sopPrev(){if(sopCurrent>0){sopCurrent--;renderSopStep();}}
function sopReset(){
  sopCurrent=0;sopChecked={};
  // Reset simulation to normal operating state
  applySopAction('reset');
  renderSopStep();
}
setTimeout(()=>{sopMode('startup');},400);

