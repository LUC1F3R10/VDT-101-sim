        </div>
        <div class="route-row">
          <span style="font-size:8px;color:#ff9f1a;font-family:'IBM Plex Mono',monospace;">SLOP</span>
          <span class="route-dest" id="pr-rt-slop" style="font-size:8px;font-family:'IBM Plex Mono',monospace;color:#2ecc71;font-weight:700;">→ TK-103</span>
        </div>
        <div class="route-row">
          <span style="font-size:8px;color:#888;font-family:'IBM Plex Mono',monospace;">RESID</span>
          <span class="route-dest" id="pr-rt-res" style="font-size:8px;font-family:'IBM Plex Mono',monospace;color:#2ecc71;font-weight:700;">→ TK-104</span>
        </div>
      </div>
    </div>
    <div class="prd" onclick="showInfo('gas');ctab('info')"><div class="pdot" style="background:var(--gas)"></div><div style="flex:1"><div class="pnm">OVERHEAD GAS</div><div class="pds">C1-C4 + H₂S</div></div><div class="prt" id="pr-gas">1,200 t/d</div></div>
    <div class="prd" onclick="showInfo('lvgo');ctab('info')"><div class="pdot" style="background:var(--llo)"></div><div style="flex:1"><div class="pnm">LLO</div><div class="pds">280–400°C TBP — LLO</div></div><div class="prt" id="pr-lvgo">12,000 bbl/d</div></div>
    <div class="prd" onclick="showInfo('hvgo');ctab('info')"><div class="pdot" style="background:var(--hlo)"></div><div style="flex:1"><div class="pnm">HLO</div><div class="pds">400–560°C TBP — HLO</div></div><div class="prt" id="pr-hvgo">18,000 bbl/d</div></div>
    <div class="prd" onclick="showInfo('slop');ctab('info')"><div class="pdot" style="background:var(--slop)"></div><div style="flex:1"><div class="pnm">SLOP WAX</div><div class="pds">TBP > 500°C</div></div><div class="prt" id="pr-slop">3,000 bbl/d</div></div>
    <div class="prd" onclick="showInfo('residue');ctab('info')"><div class="pdot" style="background:#555;border:1px solid #888"></div><div style="flex:1"><div class="pnm">⬛ VAC. RESIDUE</div><div class="pds">TBP > 560°C</div></div><div class="prt" id="pr-res">28,000 bbl/d</div></div>
    <div class="prd" onclick="showInfo('OX1');ctab('info')"><div class="pdot" style="background:#2a0808;border:1px solid #e74c3c"></div><div style="flex:1"><div class="pnm">⬛ ASPHALT</div><div class="pds">Oxidized Residue</div></div><div class="prt" id="pr-asp">— bbl/d</div></div>
    <div style="margin-top:9px;padding:9px;background:var(--card);border-radius:7px;border:1px solid var(--bdr);">
      <div style="font-size:9px;color:var(--mut);font-family:'IBM Plex Mono';margin-bottom:5px;">MATERIAL BALANCE</div>
      <div style="display:flex;justify-content:space-between;font-size:9px;margin-bottom:3px;font-family:'IBM Plex Mono'"><span style="color:var(--mut)">FEED IN</span><span style="color:var(--acc)" id="b-feed">50,000 bbl/d</span></div>
      <div style="display:flex;justify-content:space-between;font-size:9px;margin-bottom:3px;font-family:'IBM Plex Mono'"><span style="color:var(--mut)">PRODUCTS OUT</span><span style="color:#2ecc71" id="b-prod">62,200 bbl/d</span></div>
      <div style="height:1px;background:var(--bdr);margin:5px 0;"></div>
      <div class="al aok" id="b-status" style="margin:0;font-size:8px;">BALANCE OK</div>
    </div>
  </div>
</div>
</div>

<script>
// ═══════════════════════════════════════════════════════════
// SILENT ERROR HANDLER — only logs to console internally
// Does NOT trigger window.onerror (which Claude.ai catches)
// ═══════════════════════════════════════════════════════════
(function(){
  // Override console.log so it doesn't trigger Claude.ai's error display
  const origLog = console.log;
  const origWarn = console.warn;
  // Silently handle errors (still log as info)
  window.onerror = function(msg, src, line, col, err){
    // Suppress completely — return true means "handled"
    return true;
  };
  window.addEventListener('error', function(e){
    e.preventDefault();
    e.stopPropagation();
    return true;
  }, true);
  window.addEventListener('unhandledrejection', function(e){
    e.preventDefault();
    return true;
  });
})();

// Safe element accessors — never throw
function $(id){ return document.getElementById(id); }
function setText(id, val){ const el = $(id); if(el) el.textContent = val; }
function setVal(id, val){ const el = $(id); if(el) el.value = val; }
function getVal(id, fb){ const el = $(id); return el ? +el.value : (fb !== undefined ? fb : 0); }
function setAttr(id, attr, val){ const el = $(id); if(el) el.setAttribute(attr, val); }

// ═══════════ INFO DB ═══════════
const DB={
  furnace:{emoji:'🔥',name:'FURNACE',type:'Feed Preheat Fired Heater',desc:`Heats Atmospheric Residue to 400–418°C (deep-cut VDU). Above 425°C causes thermal cracking and coke formation inside radiant tubes.\n\nRefs: Sulzer Chemtech VDU (418°C COT); MDPI 2022 (deep-cut to 420°C); Refinery Ops 2015 (flash T restricted to 420°C).`,params:[{label:'OUTLET TEMP',id:'lbl-ftemp'},{label:'FUEL',val:'Gas + Fuel Oil'},{label:'EFFICIENCY',val:'88%'}],specs:[{t:'g',v:'T: 400–418°C'},{t:'y',v:'Max safe: 425°C'},{t:'r',v:'Cracking > 427°C (Mobil patent, 800°F)'}]},
  tower:{emoji:'🏛️',name:'VDT-101',type:'Vacuum Distillation Tower',desc:`Operates under vacuum (-0.93 to -0.97 bar absolute ~25-50 mmHg). Separates Atmospheric Residue into: Gas, LLO, HLO, Slop Wax, Vacuum Residue.\n\nSections: Wash Zone → LLO → HLO → Flash Zone → Stripping Zone.\n\nRefs: Khalaf 2019 (Basrah Refinery); arab-oil-naturalgas.com (3-5 mmHg top, 25-30 mmHg flash zone).`,params:[{label:'PRESSURE',id:'lbl-tpress'},{label:'FLASH ZONE T',id:'ti004'},{label:'BOTTOM LEVEL',id:'lbl-li'}],specs:[{t:'g',v:'P: -0.93 to -0.97 bar'},{t:'y',v:'Flash T: 390–410°C'},{t:'b',v:'Top T: 60–110°C'}]},
  vacuum:{emoji:'💨',name:'VACUUM EJECTORS',type:'3-Stage Steam Ejector System',desc:`3-stage steam ejectors maintain tower vacuum. Each stage uses HP steam through a converging-diverging nozzle to create suction.\n\nNormal operating vacuum: -0.93 to -0.97 bar\nAbove -0.88 bar: product quality starts dropping\nAbove -0.80 bar: HLO cut point shifts, residue increases\n\nCommon causes of vacuum loss:\n→ Low steam pressure to ejectors\n→ Condenser HE-103A/B underperforming (fouling/leak)\n→ HE-106 pre-condenser failure`,params:[{label:'VACUUM',id:'lbl-pi'},{label:'STAGES',val:'3'},{label:'DRIVER',val:'HP Steam 10–14 bar'}],specs:[{t:'g',v:'Normal: -0.93 to -0.97 bar'},{t:'y',v:'Alarm: > -0.88 bar'},{t:'r',v:'Danger: > -0.80 bar'}]},
  steam:{emoji:'♨️',name:'STRIPPING STEAM',type:'LP Steam Injection',desc:`Injected at tower bottom to lower hydrocarbon partial pressure and strip light ends from Residue. Excess raises total tower pressure.`,params:[{label:'RATE',id:'v-steam'},{label:'PRESSURE',val:'3.5 bar'},{label:'TEMP',val:'180°C'}]},
  gas:{emoji:'🟡',name:'OVERHEAD GAS',type:'Non-Condensables + Light Ends',desc:`Tower top: C1-C4, H₂S, water vapor, inerts. Path: HE-106 Pre-Cond → HE-103A → HE-103B → VC-1 → SEP-101. Reflux returns to tower top.`,params:[{label:'FLOW',id:'pr-gas'},{label:'H₂S',id:'sp-gas-h2s'},{label:'TEMP',id:'ti012'}],specs:[{t:'g',v:'T: 50–80°C'},{t:'b',v:'P: < 20 mmHg'}]},
  lvgo:{emoji:'🟢',name:'LLO',type:'Light Lube Oil (LLO)',desc:`TBP 280–400°C. Feed for Hydrotreater or FCC. Pumparound returns cold LLO to control tower top temperature. Storage: TK-101 with hot oil heating.`,params:[{label:'FLOW',id:'pr-lvgo'},{label:'API',id:'sp-lv-api'},{label:'VISC @40°C',id:'sp-lv-vis'}],specs:[{t:'g',v:'API: 28–35°'},{t:'b',v:'IBP: 285°C'}]},
  hvgo:{emoji:'🔵',name:'HLO',type:'Heavy Lube Oil (HLO)',desc:`TBP 400–560°C. Most valuable VDT product. Primary FCC/Hydrocracker feed. Storage: TK-102.`,params:[{label:'FLOW',id:'pr-hvgo'},{label:'API',id:'sp-hv-api'},{label:'CCR',id:'sp-hv-ccr'}],specs:[{t:'g',v:'API: 18–25°'},{t:'y',v:'CCR: < 1%'}]},
  slop:{emoji:'🟠',name:'SLOP WAX',type:'Intermediate Cut',desc:`Waxy intermediate TBP > 500°C. High pour point. Storage: TK-103 with hot oil heating coil to prevent solidification.`,params:[{label:'FLOW',id:'pr-slop'},{label:'POUR POINT',id:'sp-sl-pp'}]},
  residue:{emoji:'⬛',name:'VACUUM RESIDUE',type:'Vacuum Bottoms',desc:`Heaviest refinery stream. TBP > 560°C. High CCR, metals, sulfur. Storage: TK-104 with hot oil heating coils (critical!). Solidifies < 80°C.`,params:[{label:'FLOW',id:'pr-res'},{label:'API',id:'sp-rs-api'},{label:'CCR',id:'sp-rs-ccr'}],specs:[{t:'r',v:'API: < 10°'},{t:'r',v:'Solidifies < 80°C!'}]},
  PI:{emoji:'🔵',name:'PI — PRESSURE',type:'Tower Pressure Indicator',desc:`Monitors tower vacuum in negative bar. Normal: -0.94 to -0.97 bar (-0.93 to -0.96 barg).\n\nEquivalent in mmHg abs:\n-0.97 bar = 32 mmHg abs (excellent vacuum)\n-0.93 bar = 62 mmHg abs (normal operation)\n-0.88 bar = 100 mmHg abs (poor vacuum)\n-0.50 bar = 380 mmHg abs (vacuum lost!)\n\nMax vacuum achievable: ~-0.98 bar (limited by condenser CW temp)`,params:[{label:'READING',id:'lbl-pi'},{label:'NORMAL',val:'-0.93 to -0.97 bar'},{label:'ALARM',val:'> -0.88 bar (weak)'},{label:'DANGER',val:'> -0.80 bar (lost)'}]},
  LI:{emoji:'📊',name:'LI — LEVEL',type:'Tower Bottom Level',desc:`Residue level at tower bottom. Normal: 40–60%. Above 80%: overflow. Below 20%: pump cavitation.`,params:[{label:'LEVEL',id:'lbl-li'},{label:'HIGH',val:'80%'},{label:'LOW',val:'20%'}]},
  HE101:{emoji:'🔵',name:'HE-101 LLO COOLER (1st Stage)',type:'Shell & Tube + TIC-021',desc:`First stage LLO cooling. TIC-021 controls outlet at setpoint 75°C via CW bypass valve.\n\nIn series with HE-101B (trim cooler) for final 38-50°C storage temp. Gulf summer (CW 38-42°C) needs 2 stages.\n\nT/S leak = CW contaminates LLO product.`,params:[{label:'INLET',id:'ti020'},{label:'OUTLET',id:'ti021'},{label:'TIC SP',val:'75°C'}],specs:[{t:'g',v:'Outlet: 55-70°C'},{t:'b',v:'TIC controlled'}]},
  HE101B:{emoji:'❄️',name:'HE-101B LLO TRIM COOLER (2nd Stage)',type:'Trim Cooler + TIC-022',desc:`Second stage LLO cooler in series after HE-101.\n\nPurpose: Brings LLO down to final storage temp 38-50°C for TK-101.\nTIC-022 setpoint = 50°C, modulates CW bypass valve.\n\nWhy needed:\n• HE-101 brings LLO to ~60°C only\n• In Gulf summer, CW at 40°C limits HE-101 alone\n• HE-101B provides the trim cooling\n• Without it, TK-101 receives oil too warm in summer`,params:[{label:'INLET',id:'ti021'},{label:'OUTLET',id:'ti022'},{label:'TIC SP',val:'50°C'}],specs:[{t:'g',v:'Outlet: 38-52°C'},{t:'b',v:'Trim duty'},{t:'y',v:'Series with HE-101'}]},
  HE102:{emoji:'🔵',name:'HE-102 HLO COOLER (1st Stage)',type:'Shell & Tube Heat Exchanger',desc:`First stage HLO cooling. Cools HLO from ~290°C to ~55–70°C using CW. Fouling common (asphaltenes). Monitor ΔP regularly. Works in series with HE-102B for deeper cooling.`,params:[{label:'INLET',id:'ti030'},{label:'OUTLET',id:'ti031'},{label:'ISSUE',val:'Fouling'}],specs:[{t:'g',v:'HLO out: 50–100°C range'},{t:'y',v:'Normal: 65–75°C'},{t:'r',v:'Fouling: > 85°C'}]},
  HE102B:{emoji:'🔵',name:'HE-102B HLO TRIM COOLER (2nd Stage)',type:'Shell & Tube Trim Cooler',desc:`Second stage HLO cooler — works in series after HE-102.\n\nPurpose: Brings HLO down to final storage temperature of 35–50°C, especially important in summer when CW temperature rises to 38–42°C in Gulf climate.\n\nIn series arrangement:\nHE-102 does most of the cooling (heavy duty)\nHE-102B handles the last 20–30°C (trim duty)\n\nIf HE-102B bypassed: HLO enters TK-102 too hot → thermal expansion, breathing losses, product quality risk.\n\n⚠️ Fouling also occurs here but slower than HE-102.`,params:[{label:'INLET',id:'ti031'},{label:'OUTLET',id:'ti032'},{label:'CW',val:'Yes — Counter-current'}],specs:[{t:'g',v:'HLO out: 35–50°C'},{t:'b',v:'Trim duty ~10–20°C'},{t:'y',v:'Series with HE-102'}]},
  HE103A:{emoji:'❄️',name:'HE-103A CONDENSER-1',type:'Overhead Condenser',desc:`First stage overhead cooling. Gas in: ~120°C → out: ~80°C. Tube/Shell leak: CW enters gas side → tower pressure rises.`,params:[{label:'GAS IN',id:'ti010'},{label:'GAS OUT',id:'ti011'},{label:'CW',val:'Yes'}]},
  HE103B:{emoji:'❄️',name:'HE-103B CONDENSER-2',type:'Overhead Condenser',desc:`Final cooling before VC-1. Gas out must be 40–60°C. Poor cooling → VC-1 pressure rises → vacuum deteriorates.`,params:[{label:'GAS IN',id:'ti011'},{label:'GAS OUT',id:'ti012'},{label:'VC-1',val:'Connected'}],specs:[{t:'r',v:'Critical for vacuum!'}]},
  HE107:{emoji:'🟠',name:'HE-107 SLOP WAX COOLER',type:'Shell & Tube Heat Exchanger',desc:`Cools Slop Wax from ~315°C (P-103 discharge) down to 130-160°C before storage in TK-103.\n\nWhy needed:\n- Slop Wax leaves the tower at 300-340°C (very hot)\n- Direct routing to TK-103 would damage the tank\n- Cooling to ~150°C is safe for storage but stays well above pour point (+45°C)\n\n⚠️ Do NOT cool below 120°C — slop wax pour point ~+45°C, but field operators keep margin to avoid line plugging in winter.\n\nCooling medium: process cooling water at 32-38°C (Gulf climate).`,params:[{label:'INLET',id:'ti040'},{label:'OUTLET',id:'ti041'},{label:'CW',val:'Yes'}],specs:[{t:'g',v:'Outlet: 130-160°C'},{t:'r',v:'Min: 120°C (pour point margin)'},{t:'b',v:'CW: 32-38°C'}]},
  TI041:{emoji:'🌡️',name:'TI-041',type:'Slop Wax After HE-107',desc:`Slop Wax temperature after cooling. Target 130-160°C for safe transfer to TK-103.\n\nBelow 120°C: pour point approaching, line plugging risk\nAbove 180°C: tank thermal stress, vapor losses`,params:[{label:'READING',id:'ti041'},{label:'TARGET',val:'130-160°C'},{label:'MIN',val:'120°C'}]},
  HE104:{emoji:'⬛',name:'HE-104 RESIDUE COOLER',type:'Residue Cooler',desc:`Cools Vacuum Residue from ~365C to 165-195C for safe transfer to TK-104.\n\nTarget outlet: 170-185C. Min safe: 165C (below = plugging in transfer line).\nNever cool to 100C — wax deposition in 300-500m transfer line!\nIn Gulf climate: CW at 32-38C. Use bypass to control outlet T.`,params:[{label:'RES IN',id:'ti050'},{label:'RES OUT',id:'ti051'}],specs:[{t:'y',v:'out: 165-195°C'},{t:'r',v:'Min: 165°C!'}]},
  HE105:{emoji:'♨️',name:'HE-105 FEED PREHEAT',type:'Feed Preheat HX',desc:`Heats feed from 150°C to ~270°C using hot HVGO. Reduces furnace duty ~20%. Tube leak = HVGO mixes with feed.`,params:[{label:'FEED IN',id:'ti001'},{label:'FEED OUT',id:'ti002'}],specs:[{t:'g',v:'Feed out: 250–300°C'},{t:'b',v:'Saves ~20% fuel'}]},
  HE106:{emoji:'❄️',name:'HE-106 PRE-CONDENSER',type:'Pre-Condenser HX — NEW',desc:`Positioned between tower top and HE-103A. Provides initial cooling of Overhead Gas from ~75°C to ~60°C before entering the main condensers.\n\nAdvantages:\n• Reduces thermal shock on HE-103A\n• Recovers heat energy from overhead\n• Extends HE-103A tube life\n\nTube/Shell leak here causes CW contamination of overhead vapor — increases tower pressure and upsets vacuum.`,params:[{label:'GAS IN',id:'ti009'},{label:'GAS OUT',id:'ti010'},{label:'CW',val:'Yes'}],specs:[{t:'g',v:'Gas in: 70–80°C'},{t:'b',v:'Gas out: 55–65°C'},{t:'y',v:'Protects HE-103A'}]},
  VC1:{emoji:'🏺',name:'VC-1 PASS-THROUGH DRUM',type:'Overhead Drum — Full Pass-Through',desc:`VC-1 is a pass-through vessel — all condensed overhead flows immediately and completely to SEP-101. There is NO liquid accumulation inside VC-1.\n\nFunction:\n• Provides a stable connection point between the condensers (HE-103B) and SEP-101\n• Maintains vacuum connection to ejectors from the top\n• All gas + all liquid → 100% to SEP-101\n\nSEP-101 then separates:\n→ Gas phase → Clean Gas header\n→ Liquid (naphtha) → P-105 Reflux Pump → Tower top\n→ Water (H₂O) → Sour Water tank`,params:[{label:'FUNCTION',val:'Pass-Through Only'},{label:'VACUUM',val:'Ejectors connected'},{label:'ALL FLOW',val:'→ SEP-101'}]},
  SEP:{emoji:'🔄',name:'SEP-101',type:'3-Phase Gas Separator',desc:`Separates overhead into: Clean Gas → Gas Processing. Naphtha → Reflux via P-105. Sour Water → Water Treatment.`,params:[{label:'GAS OUT',val:'Clean gas'},{label:'WATER',val:'Sour Water'},{label:'TYPE',val:'3-Phase'}]},
  P100:{emoji:'⚙️',name:'P-100 FEED PUMP',type:'Centrifugal Feed Pump',desc:`Main feed pump. Low discharge = low flow = hot furnace tubes. Always has A/B standby. Trip = ESD.`,params:[{label:'DISCHARGE',id:'p100-prs'},{label:'STANDBY',val:'P-100B'},{label:'TYPE',val:'Centrifugal'}],specs:[{t:'g',v:'P: 15–20 bar'},{t:'r',v:'Trip = ESD!'}]},
  P101:{emoji:'⚙️',name:'P-101 LLO PUMP',type:'Centrifugal Product Pump',desc:`Transfers LVGO from HE-101 to TK-101. Monitor discharge pressure.`,params:[{label:'DISCHARGE',id:'p101-prs'},{label:'PRODUCT',val:'LLO → TK-101'}]},
  P102:{emoji:'⚙️',name:'P-102 HLO PUMP',type:'Centrifugal Product Pump',desc:`Transfers HVGO to TK-102/FCC feed. Pumparound circuit has separate pump.`,params:[{label:'DISCHARGE',id:'p102-prs'},{label:'PRODUCT',val:'HLO → TK-102'}]},
  P103:{emoji:'⚙️',name:'P-103 SLOP PUMP',type:'Gear Pump',desc:`Gear pump for viscous Slop Wax. Operates at 300–340°C. Delivers to TK-103.`,params:[{label:'DISCHARGE',id:'p103-prs'},{label:'TYPE',val:'Gear Pump'},{label:'PRODUCT',val:'Slop → TK-103'}]},
  P104:{emoji:'⚙️',name:'P-104 RESIDUE PUMP',type:'Gear/Screw Pump',desc:`Most critical product pump. Gear or Screw type — constant flow regardless of discharge pressure (unlike centrifugal). Residue solidifies at ~140-160C. If stopped without hot oil tracing, suction line blocks permanently. Keep tower level > 20%. Discharge: 5-8 barg to push residue 300-500m to TK-104.`,params:[{label:'DISCHARGE',id:'p104-prs'},{label:'TYPE',val:'Gear/Screw'},{label:'MAX PRESSURE',val:'2.0 barg'},{label:'PRODUCT',val:'Residue → TK-104'}],specs:[{t:'r',v:'Solidification risk!'},{t:'y',v:'Keep > 100°C always'}]},
  P105:{emoji:'⚙️',name:'P-105 REFLUX PUMP',type:'Centrifugal Reflux Pump',desc:`Pumps the liquid phase (naphtha/light condensate) from SEP-101 back to the tower top as Reflux.\n\nFlow path: SEP-101 liquid outlet → P-105 suction → tower top section\n\nReflux cools the tower top and improves LVGO/Gas separation sharpness.\n\nTrip consequences:\n→ Tower top temperature rises immediately\n→ LVGO quality deteriorates (separation worsens)\n→ Overhead gas rate increases`,params:[{label:'DISCHARGE',id:'p105-prs'},{label:'SOURCE',val:'SEP-101 liquid phase'},{label:'DESTINATION',val:'Tower top'}],specs:[{t:'r',v:'CRITICAL pump!'},{t:'g',v:'Reflux Ratio: 1.5–3'}]},
  TK101:{emoji:'🟢',name:'TK-101 LLO STORAGE',type:'Product Storage Tank',desc:`LVGO storage tank. Hot oil heating coil maintains temperature in cold weather. Normal temp: 40–50°C. Safety: floating roof tank.`,params:[{label:'TEMP',id:'lbl-tk101'},{label:'HEATING',val:'Hot Oil Coil'},{label:'TYPE',val:'Floating Roof'}]},
  TK102:{emoji:'🔵',name:'TK-102 HLO STORAGE',type:'Product Storage Tank',desc:`HLO storage tank. Receives HLO after 2-stage cooling (HE-102 + HE-102B). Normal storage temp: 38–52°C. Hot oil heating coil for cold weather. HLO pour point ~+15°C — keep above 25°C minimum.`,params:[{label:'TEMP',id:'lbl-tk102'},{label:'HEATING',val:'Hot Oil Coil'}]},
  TK103:{emoji:'🟠',name:'TK-103 SLOP WAX STORAGE',type:'Product Storage Tank',desc:`Slop Wax tank. Pour point > 40°C — hot oil heating mandatory! Temp must stay > 65°C to allow pumping.`,params:[{label:'TEMP',id:'lbl-tk103'},{label:'HEATING',val:'Hot Oil — MANDATORY'}],specs:[{t:'r',v:'Must stay > 65°C!'}]},
  TK104:{emoji:'⬛',name:'TK-104 VAC. RESIDUE STORAGE',type:'Heated Storage Tank',desc:`Critical heated storage. Vacuum Residue pour point is 130-160C. Tank maintained at 160-185C via hot oil coils.\n\nIf HBOIL-101 fails: 0-2 hrs cooling → 2-6 hrs unpumpable → 6-12 hrs solidification near walls → >12 hrs: steam lancing required.\n\nInsulated + 2 hot oil heating coils.`,params:[{label:'TEMP',id:'lbl-tk104'},{label:'HEATING',val:'2x Hot Oil Coils'},{label:'MIN PUMP TEMP',val:'160°C'},{label:'NORMAL TEMP',val:'170–185°C'}],specs:[{t:'r',v:'Min 165°C — CRITICAL'},{t:'y',v:'Normal: 170–185°C'},{t:'r',v:'< 160°C: unpumpable!'}]},
  OX1:{emoji:'🔴',name:'OX-101 OXIDATION COL.',type:'Asphalt Oxidation Column',desc:`Oxidizes Vacuum Residue with air to produce asphalt. Air pressure controls the product grade:\n\n1–2 bar → Pen 100/150 (soft)\n2–3 bar → Pen 60/70 (road)\n3–4.5 bar → Pen 40/50 (highway)\n5–6 bar → Pen 15/25 (hard/insulation)`,params:[{label:'AIR PRESSURE',id:'ox1-prs'},{label:'TEMP',id:'ox1-t'},{label:'PRODUCT',id:'ox1-grade'}],specs:[{t:'g',v:'T: 260–300°C'},{t:'b',v:'Air: 1–6 bar'}]},
  OX2:{emoji:'🔴',name:'OX-102 OXIDATION COL.',type:'Asphalt Oxidation Column',desc:`Parallel oxidation column. Can run same or different grade as OX-101.`,params:[{label:'AIR PRESSURE',id:'ox2-prs'},{label:'TEMP',id:'ox2-t'},{label:'PRODUCT',id:'ox2-grade'}]},
  OX3:{emoji:'🔴',name:'OX-103 OXIDATION COL.',type:'Asphalt Oxidation Column',desc:`Third parallel column for higher throughput or different specification.`,params:[{label:'AIR PRESSURE',id:'ox3-prs'},{label:'TEMP',id:'ox3-t'},{label:'PRODUCT',id:'ox3-grade'}]},
  BOILER:{emoji:'♨️',name:'BOILER-101',type:'Steam Utility Boiler',desc:`Produces HP steam for ejectors, stripping steam, and line tracing. Low pressure = weak vacuum = all products affected.`,params:[{label:'PRESSURE',id:'v-boiler'},{label:'TEMP',id:'lbl-boiler-t'}],specs:[{t:'g',v:'P: 10–15 bar'},{t:'r',v:'Critical for vacuum!'}]},
