function checkScenarioObjectives(){
  if(!window._activeScenario) return;
  const sc = window._activeScenario;
  const state = window._scenarioState;
  const elapsed = (Date.now() - state.startTime) / 1000;
  
  // Check each objective
  sc.objectives.forEach((obj, i) => {
    if(state.completed.includes(i) || state.failed.includes(i)) return;
    
    try {
      if(obj.check()){
        state.completed.push(i);
        showToastInline('✓ Objective complete: ' + obj.text);
      } else if(obj.timeLimit && elapsed > obj.timeLimit){
        state.failed.push(i);
        showToastInline('✗ Objective failed (timeout): ' + obj.text);
      }
    } catch(e){ /* skip */ }
  });
  
  // Check overall completion
  if(state.completed.length === sc.objectives.length){
    showToastInline('🏆 SCENARIO COMPLETE! All objectives met.');
    if(typeof activeFaults !== 'undefined') activeFaults.clear();
    setTimeout(() => { window._activeScenario = null; updateScenarioPanel(); }, 3000);
  } else if(elapsed > sc.time){
    showToastInline('⏰ TIME EXPIRED — Scenario failed');
    if(typeof activeFaults !== 'undefined') activeFaults.clear();
    window._activeScenario = null;
    updateScenarioPanel();
  }
}

