// Helper to build a heat exchanger block in SVG
function heatExchangerBlock(x, y, name, desc, T_hot_out, arrow, T_hot_in, T_cold_in, T_cold_out, prodColor, prodName){
  return (
    '<g>' +
      '<rect x="' + x + '" y="' + y + '" width="150" height="80" fill="rgba(0,0,0,.4)" stroke="#5a8aaf" stroke-width="1.5" rx="6"/>' +
      '<text x="' + (x+75) + '" y="' + (y+20) + '" text-anchor="middle" font-size="11" fill="#00d4ff" font-family="IBM Plex Mono" font-weight="700">' + name + '</text>' +
      '<text x="' + (x+75) + '" y="' + (y+34) + '" text-anchor="middle" font-size="8" fill="#7a9ec2" font-family="IBM Plex Mono">' + desc + '</text>' +
      // Hot stream label (right side, going in/out)
      '<text x="' + (x+155) + '" y="' + (y+52) + '" font-size="9" fill="' + prodColor + '" font-family="IBM Plex Mono">' + T_hot_in.toFixed(0) + '°</text>' +
      '<text x="' + (x+155) + '" y="' + (y+68) + '" font-size="8" fill="' + prodColor + '" font-family="IBM Plex Mono">' + prodName + '</text>' +
      '<text x="' + (x-5) + '" y="' + (y+52) + '" text-anchor="end" font-size="9" fill="' + prodColor + '" font-family="IBM Plex Mono">' + T_hot_out.toFixed(0) + '°</text>' +
      // Hot stream arrow through HE (right to left)
      '<line x1="' + (x+150) + '" y1="' + (y+45) + '" x2="' + x + '" y2="' + (y+45) + '" stroke="' + prodColor + '" stroke-width="2" stroke-dasharray="3,2" marker-end="url(#arr' + (prodColor === '#a8c4dd' ? 'Cold' : prodColor === '#7ecf3a' ? 'Green' : prodColor === '#65d9c8' ? 'Cyan' : 'Hot') + ')"/>' +
    '</g>'
  );
}

