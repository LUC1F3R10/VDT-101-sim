// ═══════════ TABS ═══════════
function ctab(n){
  const m={info:'cp-info',ctrl:'cp-ctrl',fault:'cp-fault',prod:'cp-prod',sop:'cp-sop',dcs:'cp-dcs'};
  document.querySelectorAll('.ctab').forEach((t,i)=>t.classList.toggle('on',['info','ctrl','fault','prod','sop','dcs'][i]===n));
  document.querySelectorAll('.cpane').forEach(c=>c.classList.remove('on'));
  if(m[n])document.getElementById(m[n]).classList.add('on');
  if(n==='dcs'){setTimeout(()=>{drawAllTrends();updateDCS();},100);}
  if(n==='sop'){setTimeout(()=>{renderSopStep();},100);}
}

// ═══════════ SHOW INFO ═══════════
function showInfo(k){
  const d=DB[k];if(!d)return;
  (function(){const _e=$('info-empty');if(_e)_e.style.display='none';})()
  const c=document.getElementById('info-card');c.style.display='block';
  let ph=(d.params||[]).map(p=>{
    const v=p.id?(document.getElementById(p.id)?.textContent||'—'):p.val;
    return`<div class="pr"><span class="plb">${p.label}</span><span class="pvl">${v}</span></div>`;
  }).join('');
  let sp=(d.specs||[]).map(s=>`<span class="sp sp-${s.t}">${s.v}</span>`).join('');
  c.innerHTML=`<div class="ihdr"><div class="iem">${d.emoji}</div><div><div class="inm">${d.name}</div><div class="ity">${d.type}</div></div></div>
    <div class="idsc">${d.desc.replace(/\n/g,'<br>')}</div>${sp?'<div style="margin-bottom:8px">'+sp+'</div>':''}${ph}`;
}

// ═══════════ SEVERITY ═══════════
function setSev(s){
  severity=s;
  document.getElementById('sv-l').className='fsb'+(s==='low'?' on-l':'');
  document.getElementById('sv-m').className='fsb'+(s==='med'?' on-m':'');
  document.getElementById('sv-h').className='fsb'+(s==='high'?' on-h':'');
}

// ═══════════ FAULT TOGGLE ═══════════
function tf(id){
  const btn=document.getElementById('fb-'+id);
  if(activeFaults.has(id)){
    activeFaults.delete(id);btn.classList.remove('active');
    const el=document.getElementById(id);if(el)el.style.display='none';
  } else {
    activeFaults.add(id);btn.classList.add('active');
    const el=document.getElementById(id);if(el)el.style.display='block';
    const f=FDB[id];
    if(f){
      const sev={'low':'🟡 LOW','med':'🟠 MEDIUM','high':'🔴 HIGH'}[severity];
      const box=document.getElementById('fdesc-box');
      box.className='fdesc show';
      box.innerHTML=`<b style="color:#e74c3c">${f.title}</b><br><b>Severity: ${sev}</b><br><br><b>Effects:</b><br>${f.effects.map(e=>'• '+e).join('<br>')}<br><br><b>Actions:</b><br>${f.actions.map(a=>'→ '+a).join('<br>')}`;
    }
  }
  (function(){const _e=$('fault-badge');if(_e)_e.style.display=activeFaults.size?'block':'none';})()
  updateFaultPanel();sim();
}

function clearFaults(){
  [...activeFaults].forEach(id=>{
    const el=document.getElementById(id);if(el)el.style.display='none';
    const btn=document.getElementById('fb-'+id);if(btn)btn.classList.remove('active');
  });
  activeFaults.clear();
  (function(){const _e=$('fault-badge');if(_e)_e.style.display='none';})()
  document.getElementById('fdesc-box').className='fdesc';
  updateFaultPanel();sim();
}

function updateFaultPanel(){
  const fp=document.getElementById('fault-panel');
  if(activeFaults.size===0){
    set('fpl-title','NO ACTIVE FAULT');
    set('fpl-status','✓ ALL SYSTEMS NORMAL');
    ['l1','l2','l3','l4'].forEach(l=>set('fpl-'+l,'—'));
    fp.setAttribute('stroke','#172a42');return;
  }
  fp.setAttribute('stroke','#e74c3c');
  const fids=[...activeFaults];
  set('fpl-title',`⚠ ${fids.length} FAULT(S) ACTIVE`);
  for(let i=0;i<4;i++) set('fpl-l'+(i+1),fids[i]?'• '+(FDB[fids[i]]?.title||fids[i]):'—');
  set('fpl-status',`⚠ SEVERITY: ${severity.toUpperCase()}`);
}

