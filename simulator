  if(view) view.classList.add('active');
  
  document.querySelectorAll('.section-btn').forEach(b => b.classList.remove('active'));
  const btn = document.getElementById('sec-' + name);
  if(btn) btn.classList.add('active');
  
  if(name === 'hx') updateHXSection();
  if(name === 'heatint') updateHeatIntegrationSection();
  if(name === 'pumps') updatePumpsSection();
  if(name === 'furnace') updateFurnaceSection();
  if(name === 'tower') updateTowerSection();
  if(name === 'score') updateScorePanel();
  if(name === 'scenarios') updateScenarioPanel();
