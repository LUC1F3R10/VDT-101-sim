  }
  
  // Reset score
  if(typeof scoreReset === 'function') scoreReset();
  
  showToastInline('🎯 SCENARIO STARTED: ' + sc.title);
  updateScenarioPanel();
}

function stopScenario(){
  window._activeScenario = null;
  if(typeof activeFaults !== 'undefined') activeFaults.clear();
  showToastInline('⛔ Scenario ended');
  updateScenarioPanel();
}

