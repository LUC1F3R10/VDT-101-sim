function parseFlowVal(elementId) {
  const el = document.getElementById(elementId);
  if(!el) return 0;
  const txt = el.textContent || '';
  const num = parseFloat(txt.replace(/,/g, ''));
  return isNaN(num) ? 0 : num;
}

function pushFlowmeters() {
  // Read PUMP flow values (what DCS shows in real refineries)
  // FI indicators are physically located on pump discharge lines
  const pf = window._pumpFlows || {};
  
  // Use pump flow if available, fallback to production panel values
  const lvgo = pf.p101 !== undefined ? pf.p101 : parseFlowVal('pr-lvgo');
  const hvgo = pf.p102 !== undefined ? pf.p102 : parseFlowVal('pr-hvgo');
  const slop = pf.p103 !== undefined ? pf.p103 : parseFlowVal('pr-slop');
  const res  = pf.p104 !== undefined ? pf.p104 : parseFlowVal('pr-res');
  
  // Feed: read directly from slider (always accurate)
  const feedSlider = document.getElementById('sl-feed');
  const feed = feedSlider ? parseFloat(feedSlider.value) : 50000;
  
  fmLvgo.push(lvgo); if(fmLvgo.length > FM_LEN) fmLvgo.shift();
  fmHvgo.push(hvgo); if(fmHvgo.length > FM_LEN) fmHvgo.shift();
  fmSlop.push(slop); if(fmSlop.length > FM_LEN) fmSlop.shift();
  fmRes.push(res);   if(fmRes.length > FM_LEN)  fmRes.shift();
  fmFeed.push(feed); if(fmFeed.length > FM_LEN) fmFeed.shift();
}

function drawFlowTrend(canvasId, data, maxVal, color, accentColor) {
  const cv = document.getElementById(canvasId);
  if(!cv) return;
  const ctx = cv.getContext('2d');
  const W = cv.width, H = cv.height;
  
  ctx.clearRect(0, 0, W, H);
  
  // Gradient background
  const bgGrad = ctx.createLinearGradient(0, 0, 0, H);
  bgGrad.addColorStop(0, 'rgba(6,14,26,0.3)');
  bgGrad.addColorStop(1, 'rgba(6,14,26,1)');
  ctx.fillStyle = '#060e1a';
  ctx.fillRect(0, 0, W, H);
  
  // Grid lines (horizontal)
  ctx.strokeStyle = 'rgba(26,52,88,0.4)';
  ctx.lineWidth = 0.5;
  for(let i=0; i<=4; i++) {
    const y = H/4 * i;
    ctx.beginPath();
    ctx.moveTo(0, y);
    ctx.lineTo(W, y);
    ctx.stroke();
  }
  
  // Grid lines (vertical) — time markers
  for(let i=0; i<=6; i++) {
    const x = W/6 * i;
    ctx.beginPath();
    ctx.moveTo(x, 0);
    ctx.lineTo(x, H);
    ctx.stroke();
  }
  
  // Find local min/max for auto-scaling
  let lmn = Math.min(...data);
  let lmx = Math.max(...data);
  const range = lmx - lmn;
  if(range < maxVal * 0.05) {
    // Add padding if range too small
    const mid = (lmn + lmx) / 2;
    lmn = mid - maxVal * 0.05;
    lmx = mid + maxVal * 0.05;
  } else {
    lmn = Math.max(0, lmn - range * 0.1);
    lmx = lmx + range * 0.1;
  }
  
  // Fill area under curve
  ctx.beginPath();
  data.forEach((v, i) => {
    const x = i / (FM_LEN-1) * W;
    const y = H - Math.max(0, Math.min(1, (v - lmn)/(lmx - lmn))) * H;
    if(i === 0) ctx.moveTo(x, y);
    else ctx.lineTo(x, y);
  });
  ctx.lineTo(W, H);
  ctx.lineTo(0, H);
  ctx.closePath();
  const fillGrad = ctx.createLinearGradient(0, 0, 0, H);
  fillGrad.addColorStop(0, accentColor + '40');
  fillGrad.addColorStop(1, accentColor + '00');
  ctx.fillStyle = fillGrad;
  ctx.fill();
  
  // Main line
  ctx.beginPath();
  ctx.strokeStyle = color;
  ctx.lineWidth = 2;
  data.forEach((v, i) => {
    const x = i / (FM_LEN-1) * W;
    const y = H - Math.max(0, Math.min(1, (v - lmn)/(lmx - lmn))) * H;
    if(i === 0) ctx.moveTo(x, y);
    else ctx.lineTo(x, y);
  });
  ctx.stroke();
  
  // Current value indicator (pulsing dot)
  const lastV = data[data.length-1];
  const lx = W - 2;
  const ly = H - Math.max(0, Math.min(1, (lastV - lmn)/(lmx - lmn))) * H;
  ctx.beginPath();
  ctx.arc(lx, Math.max(3, Math.min(H-3, ly)), 4, 0, Math.PI*2);
  ctx.fillStyle = color;
  ctx.fill();
  // Outer glow ring
  ctx.beginPath();
  ctx.arc(lx, Math.max(3, Math.min(H-3, ly)), 7, 0, Math.PI*2);
  ctx.strokeStyle = color + '50';
  ctx.lineWidth = 1;
  ctx.stroke();
}

function formatNum(n) {
  return Math.round(n).toLocaleString();
}

function updateFlowmeterStats(prefix, data, maxVal, color) {
  const min = Math.min(...data);
  const max = Math.max(...data);
  const avg = data.reduce((s,v) => s+v, 0) / data.length;
  const current = data[data.length-1];
  const deltaPct = avg > 0 ? ((max - min) / avg * 100).toFixed(1) : '0.0';
  
  const valEl = document.getElementById(`fm-${prefix}-val`);
  if(valEl) valEl.textContent = formatNum(current);
  
  const minEl = document.getElementById(`fm-${prefix}-min`);
  if(minEl) minEl.textContent = formatNum(min);
  
  const avgEl = document.getElementById(`fm-${prefix}-avg`);
  if(avgEl) avgEl.textContent = formatNum(avg);
  
  const maxEl = document.getElementById(`fm-${prefix}-max`);
  if(maxEl) maxEl.textContent = formatNum(max);
  
  const deltaEl = document.getElementById(`fm-${prefix}-delta`);
  if(deltaEl) deltaEl.textContent = '±' + deltaPct + '%';
  
  const barEl = document.getElementById(`fm-${prefix}-bar`);
  if(barEl) {
    const pct = Math.min(100, current / maxVal * 100);
    barEl.style.width = pct + '%';
  }
}

function drawAllFlowmeters() {
  // Only draw if trends section is visible
  const view = document.getElementById('view-trends');
  if(!view || !view.classList.contains('active')) return;
  
  // Draw trend charts
  drawFlowTrend('fm-trend-lvgo', fmLvgo, FM_MAX.lvgo, '#7ecf3a', 'rgba(126,207,58,');
  drawFlowTrend('fm-trend-hvgo', fmHvgo, FM_MAX.hvgo, '#65d9c8', 'rgba(101,217,200,');
  drawFlowTrend('fm-trend-slop', fmSlop, FM_MAX.slop, '#ffaa00', 'rgba(255,170,0,');
  drawFlowTrend('fm-trend-res',  fmRes,  FM_MAX.res,  '#ff8c42', 'rgba(255,140,66,');
  
  // Update stats
  updateFlowmeterStats('lvgo', fmLvgo, FM_MAX.lvgo, '#7ecf3a');
  updateFlowmeterStats('hvgo', fmHvgo, FM_MAX.hvgo, '#65d9c8');
  updateFlowmeterStats('slop', fmSlop, FM_MAX.slop, '#ffaa00');
  updateFlowmeterStats('res',  fmRes,  FM_MAX.res,  '#ff8c42');
  
  // Update top stats bar
  const totalProd = fmLvgo[fmLvgo.length-1] + fmHvgo[fmHvgo.length-1] + fmSlop[fmSlop.length-1];
  const totalFeed = fmFeed[fmFeed.length-1];
  const yieldPct = totalFeed > 0 ? (totalProd / totalFeed * 100).toFixed(0) : 0;
  
  const ftEl = document.getElementById('fm-feed-total');
  if(ftEl) ftEl.textContent = formatNum(totalFeed);
  
  const ptEl = document.getElementById('fm-prod-total');
  if(ptEl) {
    ptEl.textContent = formatNum(totalProd);
    const ptSub = ptEl.nextElementSibling;
    if(ptSub) ptSub.textContent = `bbl/d (${yieldPct}%)`;
  }
  
  const resPct = totalFeed > 0 ? ((fmRes[fmRes.length-1] / totalFeed) * 100).toFixed(0) : 0;
  const rtEl = document.getElementById('fm-res-total');
  if(rtEl) {
    rtEl.textContent = formatNum(fmRes[fmRes.length-1]);
    const rtSub = rtEl.nextElementSibling;
    if(rtSub) rtSub.textContent = `bbl/d (${resPct}%)`;
  }
  
  // Operation time
  const elapsed = Math.floor((Date.now() - _opStartTime) / 1000);
  const mins = Math.floor(elapsed / 60).toString().padStart(2, '0');
  const secs = (elapsed % 60).toString().padStart(2, '0');
  const opEl = document.getElementById('fm-op-time');
  if(opEl) opEl.textContent = `${mins}:${secs}`;
}

