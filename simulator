function calcYield(){
  const feed = parseFloat(document.getElementById('yc-feed').value) || 50000;
  const crude = document.getElementById('yc-crude').value;
  const vac = parseFloat(document.getElementById('yc-vac').value) || 50;
  const flash = parseFloat(document.getElementById('yc-flash').value) || 383;
  
  // Industry typical yields by crude type (vol%)
  const yields = {
    'arab-light':   {gas:1.0, lvgo:8.5, hvgo:24, slop:3.5, residue:63},
    'arab-heavy':   {gas:0.8, lvgo:6.0, hvgo:18, slop:4.0, residue:71},
    'basrah-light': {gas:1.2, lvgo:9.0, hvgo:25, slop:3.0, residue:61.8},
    'kirkuk':       {gas:1.5, lvgo:10, hvgo:22, slop:3.5, residue:63}
  };
  
  const y = yields[crude] || yields['arab-light'];
  
  // Adjustments
  const vacAdj = (50 - vac) / 50;  // better vacuum → more VGO
  const flashAdj = (flash - 383) / 100;  // hotter flash → more VGO
  
  const adjLvgo = y.lvgo * (1 + vacAdj * 0.05 + flashAdj * 0.1);
  const adjHvgo = y.hvgo * (1 + vacAdj * 0.08 + flashAdj * 0.15);
  const adjSlop = y.slop * (1 - vacAdj * 0.03);
  const adjResidue = 100 - y.gas - adjLvgo - adjHvgo - adjSlop;
  
  const rows = [
    {name: 'Gas', vol: y.gas, color: '#a8c4dd'},
    {name: 'LVGO (LLO)', vol: adjLvgo, color: '#7ecf3a'},
    {name: 'HVGO (HLO)', vol: adjHvgo, color: '#65d9c8'},
    {name: 'Slop Wax', vol: adjSlop, color: '#ff9f1a'},
    {name: 'Vacuum Residue', vol: adjResidue, color: '#aa6a3a'}
  ];
  
  let html = '<div class="calc-result-title">PRODUCT YIELDS</div>';
  html += '<table class="calc-table"><thead><tr><th>Product</th><th>Vol %</th><th>bbl/d</th></tr></thead><tbody>';
  rows.forEach(r => {
    const bbl = feed * (r.vol/100);
    html += '<tr><td style="color:' + r.color + ';">● ' + r.name + '</td><td>' + r.vol.toFixed(2) + '%</td><td>' + bbl.toLocaleString(undefined, {maximumFractionDigits: 0}) + '</td></tr>';
  });
  html += '</tbody></table>';
  html += '<div class="calc-note">📝 Yields based on typical refinery data. Actual yields depend on assay, contaminants, and equipment efficiency.</div>';
  
  document.getElementById('yc-result').innerHTML = html;
}

