  let html='',alarms=[];
  DCS_TAGS.forEach(t=>{
    if(t.grp){html+=`<div class="dcs-grp">${t.grp}</div>`;return;}
    const el=document.getElementById(t.src);if(!el)return;
    const raw=el.textContent.trim();
    const num=parseFloat(raw.replace(/[^0-9.\-]/g,''));
    let stat='NRM',cls='',col='#2ecc71';
    if(t.norm&&!isNaN(num)&&(num<t.norm[0]||num>t.norm[1])){col='#f59e0b';stat='DEV';}
