function updateFurnaceSection(){
  const T = getVal('sl-temp', 405);
  const F = getVal('sl-feed', 50000);
  const inEl = document.getElementById('ti002');
  const T_inlet = inEl ? parseFloat(inEl.textContent) || 280 : 280;
  
  setText('furn-r-cot', T.toFixed(0) + '°C');
  setText('furn-r-inlet', T_inlet.toFixed(0) + '°C');
  setText('furn-r-dt', (T - T_inlet).toFixed(0) + '°C');
  setText('furn-svg-cot', T.toFixed(0) + '°C → TOWER');
  
  if(typeof getTotalFiring === 'function'){
    const firing = getTotalFiring();
    const active = getActiveBurnerCount();
    setText('furn-r-firing', firing.toFixed(0) + '%');
    setText('furn-r-active', active + '/4');
    
    for(let i = 1; i <= 4; i++){
      const b = window._burners[i];
      const burnerEl = document.getElementById('furn-burner-' + i);
      if(burnerEl){
        const circle = burnerEl.querySelector('circle');
        if(circle){
          if(!b.on) circle.setAttribute('fill', '#3a3a3a');
          else {
            const intensity = b.pct / 100;
            if(intensity < 0.3) circle.setAttribute('fill', '#aa4030');
            else if(intensity < 0.7) circle.setAttribute('fill', '#ee6040');
            else circle.setAttribute('fill', '#ff8050');
          }
        }
      }
    }
    
    const statusEl = document.getElementById('furn-r-status');
    if(statusEl){
      if(F < 1000){ statusEl.textContent = '⛔ NO FEED'; statusEl.style.color = '#e74c3c'; }
      else if(active === 0){ statusEl.textContent = '⛔ ALL OFF'; statusEl.style.color = '#e74c3c'; }
      else if(active < 4){ statusEl.textContent = '🟡 PARTIAL ' + active + '/4'; statusEl.style.color = '#f59e0b'; }
      else if(T > 415){ statusEl.textContent = '⚠ DANGER'; statusEl.style.color = '#e74c3c'; }
      else { statusEl.textContent = '✓ NORMAL'; statusEl.style.color = '#2ecc71'; }
    }
  }
}

