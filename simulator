<!DOCTYPE html>
<html lang="en" dir="ltr">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0">
<title>VDT Advanced Simulator v5</title>
<link href="https://fonts.googleapis.com/css2?family=IBM+Plex+Mono:wght@400;700&family=Inter:wght@400;600;700;900&display=swap" rel="stylesheet">
<style>
:root{
  --bg:#04070d;--surf:#0b1220;--card:#0f1a2c;--bdr:#172a42;
  --txt:#d5e6f5;--mut:#3a5a7a;--acc:#00d4ff;
  --feed:#cc6600;--gas:#f5e642;--llo:#7ecf3a;--hlo:#4ecdc4;
  --slop:#ff9f1a;--res:#999;--steam:#c8d8e8;--vac:#b44fff;
  --cw:#3a8fff;--ref:#ff6bcb;--ox:#ff3333;--hot:#ffaa00;
}
*{margin:0;padding:0;box-sizing:border-box;}
body{font-family:'Inter',sans-serif;background:var(--bg);color:var(--txt);height:100vh;overflow:hidden;display:flex;flex-direction:column;}

/* TOP BAR */
.topbar{display:flex;align-items:center;gap:10px;padding:7px 14px;background:rgba(11,18,32,.98);border-bottom:1px solid var(--bdr);flex-shrink:0;z-index:60;flex-wrap:wrap;}
.ttl{font-size:13px;font-weight:700;color:var(--acc);font-family:'IBM Plex Mono',monospace;}
.sbdg{font-size:9px;font-family:'IBM Plex Mono',monospace;padding:2px 8px;border-radius:100px;border:1px solid;}
.s-run{background:rgba(46,204,113,.15);color:#2ecc71;border-color:#2ecc71;}
.s-stop{background:rgba(231,76,60,.15);color:#e74c3c;border-color:#e74c3c;}
.leg{display:flex;gap:6px;flex-wrap:wrap;align-items:center;margin-right:auto;}
.li{display:flex;align-items:center;gap:3px;font-size:8px;color:var(--mut);}
.ll{width:14px;height:3px;border-radius:2px;}
.topbtn{padding:5px 11px;border-radius:6px;border:1px solid var(--bdr);background:var(--card);color:var(--txt);font-size:10px;font-family:'IBM Plex Mono',monospace;cursor:pointer;transition:all .3s;white-space:nowrap;}
.topbtn:hover{border-color:var(--acc);color:var(--acc);}
.topbtn.on{background:rgba(231,76,60,.2);color:#e74c3c;border-color:#e74c3c;}
.brun{padding:5px 12px;border-radius:6px;border:none;font-size:11px;font-weight:700;cursor:pointer;transition:all .3s;}

/* ── SOP STYLES ── */
.sopbtn{flex:1;padding:5px 4px;border-radius:5px;border:1px solid var(--bdr);background:var(--card);color:var(--mut);font-size:8px;font-family:'IBM Plex Mono',monospace;cursor:pointer;transition:all .3s;text-align:center;}
.sopbtn:hover{border-color:var(--acc);color:var(--acc);}
.sopbtn.on{background:rgba(0,212,255,.15);color:var(--acc);border-color:var(--acc);}
.sop-bar-wrap{height:5px;background:var(--bdr);border-radius:3px;margin-bottom:10px;overflow:hidden;}
.sop-bar-fill{height:100%;background:linear-gradient(90deg,var(--acc),#0080ff);border-radius:3px;transition:width .5s ease;width:0%;}
.sopnav{padding:5px 10px;border-radius:5px;border:1px solid var(--bdr);background:var(--card);color:var(--txt);font-size:9px;font-family:'IBM Plex Mono',monospace;cursor:pointer;transition:all .3s;}
.sopnav:hover{border-color:var(--acc);color:var(--acc);}
.sop-step{background:var(--card);border:1px solid var(--bdr);border-radius:8px;padding:11px;animation:fi .3s ease;}
.sop-step-num{font-size:9px;color:var(--acc);font-family:'IBM Plex Mono',monospace;font-weight:700;margin-bottom:5px;}
.sop-step-title{font-size:12px;font-weight:700;margin-bottom:7px;color:var(--txt);}
.sop-step-desc{font-size:10px;color:#a0c0d8;line-height:1.75;font-family:'IBM Plex Mono',monospace;}
.sop-step-crit{margin-top:7px;padding:6px 8px;background:rgba(231,76,60,.08);border:1px solid rgba(231,76,60,.25);border-radius:5px;font-size:9px;color:#e74c3c;font-family:'IBM Plex Mono',monospace;}
.sop-step-ok{margin-top:7px;padding:6px 8px;background:rgba(46,204,113,.08);border:1px solid rgba(46,204,113,.25);border-radius:5px;font-size:9px;color:#2ecc71;font-family:'IBM Plex Mono',monospace;}
.sop-check{display:flex;align-items:flex-start;gap:8px;padding:6px 8px;background:var(--card);border:1px solid var(--bdr);border-radius:6px;margin-bottom:5px;cursor:pointer;transition:all .2s;}
.sop-check:hover{border-color:var(--acc);}
.sop-check.done{border-color:#2ecc71;background:rgba(46,204,113,.06);}
.sop-check.done .sop-check-box{background:#2ecc71;border-color:#2ecc71;color:#000;}
.sop-check.done .sop-check-txt{text-decoration:line-through;opacity:.5;}
.sop-check-box{width:16px;height:16px;border:2px solid var(--mut);border-radius:4px;flex-shrink:0;display:flex;align-items:center;justify-content:center;font-size:9px;font-weight:700;transition:all .3s;margin-top:1px;}
.sop-check-txt{font-size:9px;font-family:'IBM Plex Mono',monospace;color:var(--txt);line-height:1.5;}
.sop-done-msg{text-align:center;padding:16px;font-family:'IBM Plex Mono',monospace;font-size:11px;color:#2ecc71;background:rgba(46,204,113,.08);border:1px solid rgba(46,204,113,.3);border-radius:8px;}

/* ── DCS STYLES ── */
.dcs-tag{background:var(--card);border:1px solid var(--bdr);border-radius:6px;padding:6px 8px;margin-bottom:5px;display:flex;align-items:center;gap:8px;cursor:pointer;transition:border-color .3s;}
.dcs-tag:hover{border-color:var(--acc);}
.dcs-tag.alarm{border-color:#e74c3c;background:rgba(231,76,60,.06);animation:blink .8s infinite;}
.dcs-tag.warn{border-color:#f59e0b;background:rgba(245,158,11,.05);}
.dcs-tagid{font-family:'IBM Plex Mono',monospace;font-size:8px;color:var(--mut);min-width:52px;}
.dcs-tagdesc{font-family:'IBM Plex Mono',monospace;font-size:8px;color:var(--txt);flex:1;}
.dcs-pv{font-family:'IBM Plex Mono',monospace;font-size:11px;font-weight:700;min-width:72px;text-align:right;}
.dcs-unit{font-family:'IBM Plex Mono',monospace;font-size:8px;color:var(--mut);min-width:32px;}
.dcs-status{font-size:8px;font-family:'IBM Plex Mono',monospace;min-width:30px;text-align:center;}
.dcs-grp{font-family:'IBM Plex Mono',monospace;font-size:8px;font-weight:700;color:var(--acc);margin:8px 0 4px;text-transform:uppercase;letter-spacing:1px;border-bottom:1px solid var(--bdr);padding-bottom:3px;}
body.mobile-mode .body-wrap{flex-direction:column;}
body.mobile-mode .canvas-wrap{height:55vh;min-height:320px;}
body.mobile-mode .ctrl-panel{
  width:100%!important;height:45vh;
  border-left:none;border-top:1px solid var(--bdr);
  flex-shrink:0;
}
body.mobile-mode .topbar{padding:5px 10px;gap:6px;}
body.mobile-mode .leg{display:none;}
body.mobile-mode .ttl{font-size:11px;}
body.mobile-mode .rtclock{font-size:9px;}
body.mobile-mode svg{min-width:900px!important;}
body.mobile-mode .copyright-bar{flex-direction:column;gap:2px;padding:3px 10px;text-align:center;}
body.mobile-mode .cr-right{display:none;}

/* Auto mobile on small screens */
@media(max-width:700px){
  .body-wrap{flex-direction:column!important;}
  .canvas-wrap{height:52vh!important;min-height:300px!important;}
  .ctrl-panel{width:100%!important;height:48vh!important;border-left:none!important;border-top:1px solid var(--bdr)!important;flex-shrink:0!important;}
  .leg{display:none!important;}
  .cr-right{display:none!important;}
  .copyright-bar{flex-direction:column!important;gap:2px!important;padding:3px 10px!important;}
  body{font-size:11px;}
}
.bon{background:#2ecc71;color:#000;}.boff{background:#e74c3c;color:#fff;}

/* LAYOUT */
.body-wrap{display:flex;flex:1;overflow:hidden;}

/* CANVAS */
.canvas-wrap{flex:1;overflow:hidden;background:var(--bg);position:relative;}

/* SECTIONS NAVIGATION BAR */
.sections-bar{
  display:flex;
  background:linear-gradient(180deg, #0d1622 0%, #08111c 100%);
  border-bottom:1px solid var(--bdr);
  padding:6px 8px;
  gap:3px;
  overflow-x:auto;
  overflow-y:hidden;
  -webkit-overflow-scrolling:touch;
  flex-shrink:0;
  scroll-snap-type:x mandatory;
  scrollbar-width:thin;
  scrollbar-color:#00d4ff #0d1622;
}
.sections-bar::-webkit-scrollbar{height:4px;}
.sections-bar::-webkit-scrollbar-track{background:#0d1622;}
.sections-bar::-webkit-scrollbar-thumb{background:#00d4ff;border-radius:4px;}
.section-btn{
  flex-shrink:0;
  min-width:72px;
  background:transparent;
  border:1px solid transparent;
  border-radius:8px;
  padding:6px 5px;
  color:#7a9ec2;
  cursor:pointer;
  display:flex;flex-direction:column;align-items:center;gap:2px;
  font-family:'IBM Plex Mono',monospace;
  transition:all .2s;
  scroll-snap-align:start;
}
.section-btn:hover{
  background:rgba(0,212,255,.08);
  color:#00d4ff;
}
.section-btn.active{
  background:rgba(0,212,255,.12);
  border-color:#00d4ff;
  color:#00d4ff;
  box-shadow:0 0 12px rgba(0,212,255,.15);
}
.sec-icon{font-size:18px;}
.sec-label{font-size:9px;font-weight:700;letter-spacing:1px;}

/* SECTION VIEWS — only one visible at a time */
.section-view{display:none;width:100%;height:100%;overflow:auto;background:var(--bg);}
.section-view.active{display:block;}
.section-view .sv-header{
  padding:14px 18px;
  background:rgba(0,212,255,.05);
  border-bottom:1px solid var(--bdr);
  font-family:'IBM Plex Mono',monospace;
}
.section-view .sv-title{
  font-size:14px;color:#00d4ff;font-weight:700;
  letter-spacing:2px;
}
.section-view .sv-subtitle{
  font-size:9px;color:#7a9ec2;margin-top:3px;
}
.sv-content{padding:18px;}

/* Section detail cards */
.detail-card{
  background:rgba(15,25,40,.6);
  border:1px solid var(--bdr);
  border-radius:10px;
  padding:14px;
}
.dc-title{
  font-family:'IBM Plex Mono',monospace;
  font-size:10px;color:#00d4ff;
  font-weight:700;letter-spacing:1.5px;
  margin-bottom:10px;
  padding-bottom:6px;
  border-bottom:1px solid var(--bdr);
}
.reading-row{
  display:flex;justify-content:space-between;
  font-family:'IBM Plex Mono',monospace;
  font-size:10px;color:#a8c4dd;
  padding:5px 0;
  border-bottom:1px solid rgba(122,158,194,.1);
}
.reading-row b{color:#00d4ff;font-weight:700;}

.furnace-detail-grid{
  display:grid;
  grid-template-columns:repeat(2, 1fr);
  gap:14px;
}
@media (max-width:700px){
  .furnace-detail-grid{grid-template-columns:1fr;}
  .furnace-detail-grid .detail-card[style*="grid-column"]{grid-column:span 1!important;}
}

.hx-grid{
  display:grid;
  grid-template-columns:repeat(auto-fit, minmax(280px, 1fr));
  gap:12px;
}
.hx-card{
  background:rgba(15,25,40,.6);
  border:1px solid var(--bdr);
  border-radius:10px;
  padding:12px;
}
.hx-card-header{
  display:flex;justify-content:space-between;align-items:center;
  margin-bottom:8px;padding-bottom:6px;
  border-bottom:1px solid var(--bdr);
}
.hx-card-name{
  font-family:'IBM Plex Mono',monospace;
  font-size:11px;color:#00d4ff;font-weight:700;
}
.hx-card-status{
  font-size:8px;padding:2px 8px;border-radius:100px;
  font-family:'IBM Plex Mono',monospace;
}
.hx-status-ok{background:rgba(46,204,113,.15);color:#2ecc71;}
.hx-status-warn{background:rgba(245,158,11,.15);color:#f59e0b;}
.hx-temps{
  display:grid;
  grid-template-columns:repeat(3, 1fr);
  gap:6px;font-family:'IBM Plex Mono',monospace;
  font-size:9px;text-align:center;
}
.hx-temp-block{
  background:rgba(0,212,255,.05);
  padding:6px;border-radius:6px;
}
.hx-temp-label{color:#7a9ec2;font-size:8px;}
.hx-temp-value{color:#00d4ff;font-size:13px;font-weight:700;margin-top:2px;}

.pumps-grid{
  display:grid;
  grid-template-columns:repeat(auto-fit, minmax(220px, 1fr));
  gap:12px;
}
.pump-card{
  background:rgba(15,25,40,.6);
  border:1px solid var(--bdr);
  border-radius:10px;
  padding:14px;
  cursor:pointer;
  transition:all .2s;
}
.pump-card:hover{
  border-color:#00d4ff;
  box-shadow:0 0 16px rgba(0,212,255,.15);
}

/* SVG container — zoom & pan */
.svg-container{
  width:100%;height:100%;
  overflow:auto;
  -webkit-overflow-scrolling:touch;
  position:relative;
  cursor:grab;
}
.svg-container:active{cursor:grabbing;}
#mainSvg{
  transform-origin:top left;
  transition:transform .1s ease-out;
  min-width:100%;
  min-height:100%;
}

/* Zoom controls floating panel */
.zoom-controls{
  position:absolute;
  top:10px;left:10px;
  display:flex;gap:4px;align-items:center;
  background:rgba(9,18,30,.92);
  border:1px solid var(--bdr);
  border-radius:8px;
  padding:4px;
  z-index:50;
  box-shadow:0 2px 8px rgba(0,0,0,.4);
}
.zoom-btn{
  width:36px;height:36px;
  background:var(--card);
  border:1px solid var(--bdr);
  border-radius:6px;
  color:var(--acc);
  font-size:14px;
  cursor:pointer;
  display:flex;align-items:center;justify-content:center;
  transition:all .2s;
  font-family:'IBM Plex Mono',monospace;
}
.zoom-btn:hover{background:var(--acc);color:var(--bg);}
.zoom-btn:active{transform:scale(.92);}
.zoom-level{
  font-family:'IBM Plex Mono',monospace;
  font-size:10px;color:var(--acc);
  font-weight:700;padding:0 8px;
  min-width:42px;text-align:center;
}

/* RIGHT CONTROL PANEL */
.ctrl-panel{width:290px;background:var(--surf);border-left:1px solid var(--bdr);display:flex;flex-direction:column;overflow:hidden;flex-shrink:0;transition:width .3s ease;position:relative;}

/* Collapsed state — hide panel completely */
.ctrl-panel.collapsed{
  width:0!important;
  border-left:none!important;
  overflow:hidden!important;
}
.ctrl-panel.collapsed .ctrl-tabs,
.ctrl-panel.collapsed .cpane,
.ctrl-panel.collapsed .panel-toggle{display:none!important;}

/* Floating toggle button — always visible on right edge */
.panel-toggle{
  position:absolute;
  top:50%;
  left:-24px;
  transform:translateY(-50%);
  width:24px;
  height:60px;
  background:var(--card);
  border:1px solid var(--bdr);
  border-right:none;
  border-radius:8px 0 0 8px;
  color:var(--acc);
  font-family:'IBM Plex Mono',monospace;
  font-size:16px;
  font-weight:700;
  cursor:pointer;
  display:flex;
  align-items:center;
  justify-content:center;
  z-index:55;
  transition:all .2s;
  box-shadow:-2px 0 8px rgba(0,0,0,.4);
}
.panel-toggle:hover{background:var(--acc);color:var(--bg);}
.ctrl-tabs{display:flex;border-bottom:1px solid var(--bdr);}
.ctab{flex:1;padding:7px 2px;text-align:center;font-size:9px;font-weight:700;cursor:pointer;color:var(--mut);border-bottom:2px solid transparent;font-family:'IBM Plex Mono',monospace;transition:all .3s;}
.ctab.on{color:var(--acc);border-bottom-color:var(--acc);}
.cpane{display:none;flex:1;overflow-y:auto;padding:11px;}
.cpane.on{display:block;}

/* INFO */
.einfo{display:flex;flex-direction:column;align-items:center;justify-content:center;height:180px;color:var(--mut);text-align:center;gap:8px;font-size:11px;font-family:'IBM Plex Mono',monospace;}
@keyframes fi{from{opacity:0;transform:translateY(5px)}to{opacity:1;transform:translateY(0)}}
.icard{animation:fi .3s ease;}
.ihdr{display:flex;align-items:center;gap:9px;margin-bottom:9px;}
.iem{font-size:22px;}.inm{font-size:14px;font-weight:700;}.ity{font-size:9px;color:var(--acc);font-family:'IBM Plex Mono',monospace;}
.idsc{font-size:10px;color:#a0c0d8;line-height:1.8;margin-bottom:9px;background:rgba(0,212,255,.04);border:1px solid rgba(0,212,255,.1);border-radius:7px;padding:9px;font-family:'IBM Plex Mono',monospace;}
.pr{display:flex;justify-content:space-between;align-items:center;padding:5px 8px;background:var(--card);border-radius:5px;border:1px solid var(--bdr);margin-bottom:4px;}
.plb{font-size:9px;color:var(--mut);font-family:'IBM Plex Mono',monospace;}
.pvl{font-size:10px;font-weight:700;font-family:'IBM Plex Mono',monospace;color:var(--acc);}
.sp{display:inline-block;font-size:8px;padding:2px 6px;border-radius:100px;margin:2px;font-family:'IBM Plex Mono',monospace;}
.sp-g{background:rgba(46,204,113,.15);color:#2ecc71;border:1px solid #2ecc71;}
.sp-y{background:rgba(245,230,66,.15);color:#f5e642;border:1px solid #f5e642;}
.sp-r{background:rgba(231,76,60,.15);color:#e74c3c;border:1px solid #e74c3c;}
.sp-b{background:rgba(0,212,255,.15);color:#00d4ff;border:1px solid #00d4ff;}

/* SLIDERS */
.cs{margin-bottom:13px;}
.ct{font-size:9px;font-weight:700;color:var(--acc);font-family:'IBM Plex Mono',monospace;margin-bottom:6px;text-transform:uppercase;letter-spacing:1px;border-bottom:1px solid var(--bdr);padding-bottom:3px;}
.sr{margin-bottom:8px;}
.sh{display:flex;justify-content:space-between;margin-bottom:2px;}
.sl{font-size:9px;color:var(--txt);font-family:'IBM Plex Mono',monospace;}
.sv{font-size:9px;font-family:'IBM Plex Mono',monospace;color:var(--acc);font-weight:700;}
input[type=range]{width:100%;-webkit-appearance:none;height:4px;border-radius:3px;background:var(--bdr);outline:none;cursor:pointer;}
input[type=range]::-webkit-slider-thumb{-webkit-appearance:none;width:13px;height:13px;border-radius:50%;background:var(--acc);cursor:pointer;box-shadow:0 0 4px var(--acc);}
.se{font-size:8px;color:var(--mut);margin-top:1px;font-family:'IBM Plex Mono',monospace;}

/* FAULTS */
.fg{display:grid;grid-template-columns:1fr 1fr;gap:5px;margin-bottom:7px;}
.fbtn{padding:6px 5px;border-radius:6px;border:1px solid var(--bdr);background:var(--card);color:var(--txt);font-size:8px;font-family:'IBM Plex Mono',monospace;cursor:pointer;text-align:center;transition:all .3s;line-height:1.4;}
.fbtn:hover{border-color:var(--acc);color:var(--acc);}
.fbtn.active{border-color:#e74c3c;background:rgba(231,76,60,.15);color:#e74c3c;}
.fsev{display:flex;gap:4px;margin-bottom:7px;}
.fsb{flex:1;padding:4px;border-radius:5px;border:1px solid var(--bdr);background:var(--card);font-size:8px;font-family:'IBM Plex Mono',monospace;cursor:pointer;text-align:center;transition:all .3s;}
.fsb.on-l{background:rgba(46,204,113,.2);color:#2ecc71;border-color:#2ecc71;}
.fsb.on-m{background:rgba(245,158,11,.2);color:#f59e0b;border-color:#f59e0b;}
.fsb.on-h{background:rgba(231,76,60,.2);color:#e74c3c;border-color:#e74c3c;}
.fdesc{font-size:9px;color:#a0c0d8;background:rgba(231,76,60,.05);border:1px solid rgba(231,76,60,.2);border-radius:6px;padding:8px;margin-bottom:7px;line-height:1.7;font-family:'IBM Plex Mono',monospace;display:none;}
.fdesc.show{display:block;}
.clrbtn{width:100%;padding:6px;border-radius:6px;border:1px solid #2ecc71;background:rgba(46,204,113,.1);color:#2ecc71;font-size:9px;font-family:'IBM Plex Mono',monospace;cursor:pointer;transition:all .3s;}
.clrbtn:hover{background:#2ecc71;color:#000;}

/* PRODUCTS */
.prd{display:flex;align-items:center;gap:7px;padding:6px 8px;background:var(--card);border-radius:6px;border:1px solid var(--bdr);margin-bottom:5px;cursor:pointer;transition:border-color .3s;}
.prd:hover{border-color:var(--acc);}
.pdot{width:9px;height:9px;border-radius:50%;flex-shrink:0;}
.pnm{font-size:9px;font-weight:700;font-family:'IBM Plex Mono',monospace;}
.pds{font-size:8px;color:var(--mut);}
.prt{font-size:9px;font-family:'IBM Plex Mono',monospace;color:var(--acc);font-weight:700;white-space:nowrap;}

.al{padding:5px 8px;border-radius:5px;font-size:8px;margin-bottom:4px;border:1px solid;animation:fi .3s;font-family:'IBM Plex Mono',monospace;}
.aok{background:rgba(46,204,113,.1);border-color:#2ecc71;color:#2ecc71;}
.aw{background:rgba(245,158,11,.1);border-color:#f59e0b;color:#f59e0b;}
.ae{background:rgba(231,76,60,.1);border-color:#e74c3c;color:#e74c3c;}

/* SVG */
.clk{cursor:pointer;}.clk:hover{filter:brightness(1.4);}
.cl{font-family:'IBM Plex Mono',monospace;font-size:9px;fill:#6090b0;pointer-events:none;}
.vv{font-family:'IBM Plex Mono',monospace;font-size:8px;fill:#00d4ff;pointer-events:none;}
.pl{font-family:'IBM Plex Mono',monospace;font-size:8px;font-weight:700;pointer-events:none;}
.tiv{font-family:'IBM Plex Mono',monospace;font-size:8px;fill:#ffaaaa;pointer-events:none;}

@keyframes blink{0%,100%{opacity:1}50%{opacity:.25}}
.fault-overlay{animation:blink .8s infinite;}
.leak-drop{fill:#3a8fff;opacity:.9;animation:blink .5s infinite;}

@keyframes fR{0%{stroke-dashoffset:26}100%{stroke-dashoffset:0}}
@keyframes fL{0%{stroke-dashoffset:0}100%{stroke-dashoffset:26}}
@keyframes fU{0%{stroke-dashoffset:26}100%{stroke-dashoffset:0}}
@keyframes fD{0%{stroke-dashoffset:0}100%{stroke-dashoffset:26}}
.fr{stroke-dasharray:7 5;animation:fR .7s linear infinite;}
.fl{stroke-dasharray:7 5;animation:fL .7s linear infinite;}
.fu{stroke-dasharray:7 5;animation:fU .7s linear infinite;}
.fd{stroke-dasharray:7 5;animation:fD .7s linear infinite;}
.paused{animation-play-state:paused!important;}

@keyframes spin{0%{transform:rotate(0deg)}100%{transform:rotate(360deg)}}
.pspin{animation:spin .9s linear infinite;transform-origin:center;}

/* PUMP CONTROL MODAL */
.pump-modal-overlay{
  display:none;position:fixed;
  top:0;left:0;right:0;bottom:0;
  background:rgba(0,0,0,.75);z-index:99999;
  align-items:center;justify-content:center;
  -webkit-backdrop-filter:blur(4px);backdrop-filter:blur(4px);
  overflow-y:auto;padding:20px;
  -webkit-overflow-scrolling:touch;
}

@keyframes coach-pulse {
  0%, 100% { box-shadow: 0 0 0 0 rgba(0,212,255,.4); }
  50% { box-shadow: 0 0 0 6px rgba(0,212,255,0); }
}

/* PROCESS CALCULATORS */
.calc-tabs {
  display:flex;gap:4px;
  background:rgba(15,25,40,.6);
  border-radius:8px;padding:4px;
  margin-bottom:12px;
  overflow-x:auto;
  -webkit-overflow-scrolling:touch;
}
.calc-tab {
  flex-shrink:0;
  background:transparent;
  border:none;color:#7a9ec2;
  padding:8px 12px;border-radius:5px;
  font-family:'IBM Plex Mono',monospace;font-size:9px;
  cursor:pointer;font-weight:700;letter-spacing:.5px;
  transition:all .2s;
}
.calc-tab.active{background:rgba(126,207,58,.15);color:#7ecf3a;}
.calc-tab:hover{color:#fff;}

.calc-section {
  background:rgba(10,18,30,.6);
  border:1px solid var(--bdr);
  border-radius:10px;padding:14px;
}
.calc-title {
  font-family:'IBM Plex Mono',monospace;
  font-size:13px;color:#7ecf3a;font-weight:700;
  letter-spacing:1px;margin-bottom:6px;
}
.calc-desc {
  font-family:'IBM Plex Mono',monospace;
  font-size:9px;color:#7a9ec2;
  line-height:1.5;margin-bottom:12px;
  padding-bottom:10px;
  border-bottom:1px solid var(--bdr);
}
.calc-subhead {
  font-family:'IBM Plex Mono',monospace;
  font-size:9px;color:#00d4ff;font-weight:700;
  letter-spacing:1px;margin:10px 0 6px;
}
.calc-grid {
  display:grid;
  grid-template-columns:repeat(auto-fit,minmax(240px,1fr));
  gap:8px;
  margin-bottom:12px;
}
.calc-input-row {
  display:flex;flex-direction:column;gap:4px;
}
.calc-input-row label {
  font-family:'IBM Plex Mono',monospace;
  font-size:9px;color:#a8c4dd;
}
.calc-input-row input,
.calc-input-row select {
  background:rgba(0,0,0,.3);
  border:1px solid var(--bdr);
  border-radius:5px;
  padding:7px 10px;
  color:#00d4ff;
  font-family:'IBM Plex Mono',monospace;
  font-size:11px;
}
.calc-input-row input:focus,
.calc-input-row select:focus {
  outline:none;border-color:#00d4ff;
}
.calc-btn {
  width:100%;
  background:rgba(126,207,58,.15);
  border:1px solid #7ecf3a;
  border-radius:6px;
  color:#7ecf3a;
  padding:9px;
  font-family:'IBM Plex Mono',monospace;
  font-size:10px;font-weight:700;
  cursor:pointer;letter-spacing:1px;
  margin-bottom:6px;
}
.calc-btn:hover{background:#7ecf3a;color:#000;}
.calc-btn-load {
  background:rgba(0,212,255,.1);
  border-color:#00d4ff;color:#00d4ff;
}
.calc-btn-load:hover{background:#00d4ff;color:#000;}

.calc-result {
  margin-top:12px;
  background:rgba(0,0,0,.3);
  border-radius:8px;padding:12px;
}
.calc-result-title {
  font-family:'IBM Plex Mono',monospace;
  font-size:10px;color:#7ecf3a;font-weight:700;
  letter-spacing:1.5px;margin-bottom:10px;
  padding-bottom:6px;border-bottom:1px solid var(--bdr);
}
.calc-row {
  display:flex;justify-content:space-between;
  font-family:'IBM Plex Mono',monospace;
  font-size:10px;color:#a8c4dd;
  padding:5px 0;
  border-bottom:1px solid rgba(122,158,194,.08);
}
.calc-row b{color:#00d4ff;font-weight:700;}
.calc-result-status {
  font-family:'IBM Plex Mono',monospace;
  font-size:11px;font-weight:700;
  text-align:center;padding:10px;
  border-radius:6px;margin-top:10px;
  letter-spacing:1px;
}
.calc-note {
  font-family:'IBM Plex Mono',monospace;
  font-size:9px;color:#7a9ec2;
  line-height:1.5;margin-top:12px;
  padding:10px;background:rgba(0,212,255,.05);
  border-radius:6px;
}
.calc-table {
  width:100%;border-collapse:collapse;
  font-family:'IBM Plex Mono',monospace;
  font-size:10px;
}
.calc-table th {
  text-align:left;padding:6px;
  background:rgba(0,212,255,.1);
  color:#00d4ff;font-weight:700;
  font-size:9px;letter-spacing:1px;
}
.calc-table td {
  padding:6px;color:#a8c4dd;
  border-bottom:1px solid rgba(122,158,194,.08);
}
.pump-modal-overlay.show{display:flex!important;}
.pump-modal{
  background:var(--surf);border:1px solid var(--bdr);
  border-radius:12px;padding:18px;
  min-width:340px;max-width:420px;
  max-height:90vh;overflow-y:auto;
  box-shadow:0 8px 32px rgba(0,0,0,.6);
}
.pm-header{display:flex;align-items:center;gap:10px;margin-bottom:14px;border-bottom:1px solid var(--bdr);padding-bottom:10px;}
.pm-emoji{font-size:24px;}
.pm-title{font-family:'IBM Plex Mono',monospace;font-size:13px;color:var(--acc);font-weight:700;}
.pm-subtitle{font-family:'IBM Plex Mono',monospace;font-size:9px;color:var(--mut);}
.pm-status{display:flex;align-items:center;justify-content:space-between;padding:8px 11px;background:var(--card);border-radius:7px;border:1px solid var(--bdr);margin-bottom:8px;}
.pm-stat-label{font-family:'IBM Plex Mono',monospace;font-size:9px;color:var(--mut);}
.pm-stat-value{font-family:'IBM Plex Mono',monospace;font-size:11px;color:var(--acc);font-weight:700;}
.pm-section-title{font-family:'IBM Plex Mono',monospace;font-size:9px;color:var(--acc);font-weight:700;margin:12px 0 6px;text-transform:uppercase;letter-spacing:1px;}
.pm-actions{display:flex;flex-direction:column;gap:6px;}
.pm-btn{
  padding:10px 12px;border-radius:7px;
  font-family:'IBM Plex Mono',monospace;font-size:10px;font-weight:700;
  cursor:pointer;border:1px solid;transition:all .2s;
  text-align:left;display:flex;align-items:center;gap:8px;
}
.pm-btn-stop{background:rgba(231,76,60,.1);color:#e74c3c;border-color:#e74c3c;}
.pm-btn-stop:hover{background:#e74c3c;color:#fff;}
.pm-btn-slop{background:rgba(255,159,26,.1);color:#ff9f1a;border-color:#ff9f1a;}
.pm-btn-slop:hover{background:#ff9f1a;color:#000;}
.pm-btn-storage{background:rgba(46,204,113,.1);color:#2ecc71;border-color:#2ecc71;}
.pm-btn-storage:hover{background:#2ecc71;color:#000;}
.pm-btn-info{background:rgba(0,212,255,.1);color:#00d4ff;border-color:#00d4ff;}
.pm-btn-info:hover{background:#00d4ff;color:#000;}
.pm-btn-close{background:var(--card);color:var(--mut);border-color:var(--bdr);justify-content:center;margin-top:10px;}
.pm-btn-close:hover{border-color:var(--acc);color:var(--acc);}
.pm-active{background:rgba(231,76,60,.2)!important;color:#e74c3c!important;border-color:#e74c3c!important;}

/* BURNER CONTROLS */
.burner-row{
  display:flex;align-items:center;gap:8px;
  background:var(--card);border:1px solid var(--bdr);
  border-radius:7px;padding:7px 10px;margin-bottom:6px;
  transition:all .2s;
}
.burner-row.off{opacity:.45;background:rgba(231,76,60,.05);border-color:rgba(231,76,60,.3);}
.burner-label{
  display:flex;align-items:center;gap:6px;
  font-family:'IBM Plex Mono',monospace;font-size:9px;
  color:var(--acc);font-weight:700;flex:0 0 92px;
}
.burner-icon{font-size:14px;transition:all .3s;}
.burner-row.off .burner-icon{filter:grayscale(1) brightness(.4);}
.burner-controls{display:flex;align-items:center;gap:8px;flex:1;}
.burner-toggle-btn{
  width:38px;height:22px;border-radius:5px;border:1px solid #2ecc71;
  background:rgba(46,204,113,.15);color:#2ecc71;
  font-family:'IBM Plex Mono',monospace;font-size:9px;font-weight:700;
  cursor:pointer;transition:all .2s;
}
.burner-toggle-btn.off{
  background:rgba(231,76,60,.15);color:#e74c3c;border-color:#e74c3c;
}
.burner-toggle-btn:hover{filter:brightness(1.3);}
.burner-slider{flex:1;height:5px;cursor:pointer;}
.burner-row.off .burner-slider{pointer-events:none;opacity:.3;}
.burner-pct{
  font-family:'IBM Plex Mono',monospace;font-size:10px;
  color:var(--acc);font-weight:700;flex:0 0 38px;text-align:right;
}
/* REAL-TIME CLOCK */
.rtclock{font-family:'IBM Plex Mono',monospace;font-size:10px;color:var(--acc);white-space:nowrap;}
