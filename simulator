function calcPADuty(){
  const stream = document.getElementById('pa-stream').value;
  const flow = parseFloat(document.getElementById('pa-flow').value) || 0;
  const Tdraw = parseFloat(document.getElementById('pa-draw').value) || 0;
  const Treturn = parseFloat(document.getElementById('pa-return').value) || 0;
  
  // Properties by stream
  const props = stream === 'lvgo' 
    ? {cp: 2.45, rho: 820, name: 'LVGO'}
    : {cp: 2.55, rho: 870, name: 'HVGO'};
  
  const flow_kgs = flow * 0.159 / 86400 * props.rho;
  const dT = Tdraw - Treturn;
  const Q_kw = flow_kgs * props.cp * dT;
  const Q_mmbtu = Q_kw * 0.003412;
  
  // Compare to industry typical
  const typical = stream === 'lvgo' ? 85 : 82;  // OGJ 1992 Lieberman
  const ratio = (Q_mmbtu / typical) * 100;
  
  document.getElementById('pa-result').innerHTML = 
    '<div class="calc-result-title">' + props.name + ' P/A DUTY</div>' +
    '<div class="calc-row"><span>Mass flow:</span><b>' + flow_kgs.toFixed(1) + ' kg/s</b></div>' +
    '<div class="calc-row"><span>ΔT (cooling):</span><b>' + dT.toFixed(0) + ' °C</b></div>' +
    '<div class="calc-row"><span>Duty (Q):</span><b style="color:#65d9c8;">' + Q_kw.toFixed(0) + ' kW</b></div>' +
    '<div class="calc-row"><span>Duty (Q):</span><b style="color:#65d9c8;">' + Q_mmbtu.toFixed(1) + ' MMBtu/hr</b></div>' +
    '<div class="calc-row"><span>Industry typical:</span><b>' + typical + ' MMBtu/hr</b></div>' +
    '<div class="calc-row"><span>vs typical:</span><b style="color:' + (ratio>90&&ratio<110?'#2ecc71':'#f59e0b') + ';">' + ratio.toFixed(0) + '%</b></div>' +
    '<div class="calc-note">📝 Ref: OGJ 1992 (Lieberman) — LVGO P/A ~85 MMBtu/hr, HVGO P/A ~82 MMBtu/hr at design.</div>';
}

