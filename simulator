// PUMP CONTROL MODAL — physically affects sliders + routing
// ═══════════════════════════════════════════════════════════
let currentPumpId = null;

const PUMP_DATA = {
  P101: {emoji:'⚙️', name:'P-101', subtitle:'LLO Product Pump', sliderId:'sl-p101', normal:4.0, product:'llo', hasRouting:true},
  P102: {emoji:'⚙️', name:'P-102', subtitle:'HLO Product Pump', sliderId:'sl-p102', normal:5.0, product:'hlo', hasRouting:true},
  P103: {emoji:'⚙️', name:'P-103', subtitle:'Slop Wax Gear Pump', sliderId:'sl-p103', normal:6.0, product:'slop', hasRouting:false},
  P104: {emoji:'⚙️', name:'P-104', subtitle:'Vacuum Residue Pump', sliderId:'sl-p104', normal:0.50, product:'res', hasRouting:false},
  P105: {emoji:'⚙️', name:'P-105', subtitle:'Reflux Pump', sliderId:'sl-p105', normal:2.5, product:'reflux', hasRouting:false},
};

function openPumpModal(pumpId){
  const p = PUMP_DATA[pumpId];
  if(!p) return;
  currentPumpId = pumpId;
  
  // Header
  document.getElementById('pm-emoji').textContent = p.emoji;
  document.getElementById('pm-title').textContent = p.name;
  document.getElementById('pm-subtitle').textContent = p.subtitle;
  
  // Status
  const slider = document.getElementById(p.sliderId);
  const press = parseFloat(slider.value);
  document.getElementById('pm-press').textContent = press.toFixed(2)+' barg';
  
  // Flow & status
  const flowEl = document.getElementById(p.product==='reflux' ? null : 'p'+pumpId.slice(1).toLowerCase()+'-prs');
  const prsLabel = document.getElementById(pumpId.toLowerCase().replace('p','p')+'-prs');
  // Simpler: read from p101-prs etc
  const dispEl = document.getElementById(pumpId.toLowerCase()+'-prs');
  if(dispEl) document.getElementById('pm-flow').textContent = dispEl.textContent.split('|').slice(1).join('|').trim() || '—';
  
  // Status (running/stopped)
  const isStopped = press < 0.05;
  const stat = document.getElementById('pm-status');
  stat.textContent = isStopped ? '⛔ STOPPED' : '✓ RUNNING';
  stat.style.color = isStopped ? '#e74c3c' : '#2ecc71';
  
  // Routing
  const routeStat = document.getElementById('pm-routing');
  if(p.hasRouting && typeof routing !== 'undefined'){
    const dest = routing[p.product] || 'storage';
    const labels = {storage:'→ STORAGE', slop:'→ SLOP TANK', offline:'OFFLINE'};
    const colors = {storage:'#2ecc71', slop:'#f59e0b', offline:'#e74c3c'};
    routeStat.textContent = labels[dest] || dest;
    routeStat.style.color = colors[dest] || '#2ecc71';
  } else {
    routeStat.textContent = '—';
  }
  
  // Show/hide routing section
  const rsec = document.getElementById('pm-routing-section');
  const rgrp = document.getElementById('pm-routing-actions');
  if(p.hasRouting){
    rsec.style.display = 'block';
    rgrp.style.display = 'flex';
    // Highlight active routing
    const dest = (typeof routing !== 'undefined') ? routing[p.product] : 'storage';
    document.getElementById('pm-route-storage').classList.toggle('pm-active', dest==='storage');
    document.getElementById('pm-route-slop').classList.toggle('pm-active', dest==='slop');
  } else {
    rsec.style.display = 'none';
    rgrp.style.display = 'none';
  }
  
  // Show modal
  document.getElementById('pumpModal').classList.add('show');
}

function closePumpModal(){
  document.getElementById('pumpModal').classList.remove('show');
  currentPumpId = null;
}

function pumpAction(action){
  const p = PUMP_DATA[currentPumpId];
  if(!p) return;
  const slider = document.getElementById(p.sliderId);
  
  if(action === 'stop'){
    slider.value = 0;
    sim();
    showToastInline('⛔ '+p.name+' STOPPED — Pressure → 0 barg');
  }
  else if(action === 'start'){
    slider.value = p.normal;
    sim();
    showToastInline('▶ '+p.name+' STARTED — Pressure → '+p.normal+' barg');
  }
  else if(action === 'route-storage'){
    if(typeof routing !== 'undefined' && p.hasRouting){
      routing[p.product] = 'storage';
      if(typeof updateRoutingDisplay === 'function') updateRoutingDisplay();
      showToastInline('🟢 '+p.product.toUpperCase()+' routed to STORAGE');
    }
  }
  else if(action === 'route-slop'){
    if(typeof routing !== 'undefined' && p.hasRouting){
      routing[p.product] = 'slop';
      if(typeof updateRoutingDisplay === 'function') updateRoutingDisplay();
      showToastInline('🟠 '+p.product.toUpperCase()+' routed to SLOP TANK');
    }
  }
  else if(action === 'info'){
    showInfo(currentPumpId);
    ctab('info');
    closePumpModal();
    return;
  }
  
  // Refresh modal display
  setTimeout(()=>openPumpModal(currentPumpId), 100);
}

function showToastInline(msg){
  if(typeof showToast === 'function') showToast(msg);
}

// ═══════════════════════════════════════════════════════════
// FURNACE CONTROL MODAL — 4 INDEPENDENT BURNERS
// ═══════════════════════════════════════════════════════════
// Each burner contributes 25% of total firing capacity
// Total firing rate = average of 4 burner rates (off=0)
// Outlet temp scales linearly: T_out = 200 + (firing/100) × 230
// ═══════════════════════════════════════════════════════════

window._burners = window._burners || {
  1: {on: true,  pct: 85},
  2: {on: true,  pct: 85},
  3: {on: true,  pct: 85},
  4: {on: true,  pct: 85}
};

function getTotalFiring(){
  let total = 0;
  for(let i=1; i<=4; i++){
    const b = window._burners[i];
    if(b.on) total += b.pct;
  }
  return total / 4;
}

function getActiveBurnerCount(){
  let n = 0;
  for(let i=1; i<=4; i++) if(window._burners[i].on) n++;
  return n;
}

function applyBurnersToFurnace(){
  const firing = getTotalFiring();
  const T_target = 200 + (firing/100) * 230;
  const tempSlider = document.getElementById('sl-temp');
  if(tempSlider){
    tempSlider.value = Math.round(T_target);
    sim();
  }
}

function toggleBurner(num){
  const b = window._burners[num];
  b.on = !b.on;
  const row = document.getElementById('burner-'+num+'-row');
  const btn = document.getElementById('burner-'+num+'-toggle');
  if(!b.on){
    if(row) row.classList.add('off');
    if(btn){ btn.classList.add('off'); btn.textContent = 'OFF'; }
  } else {
    if(row) row.classList.remove('off');
    if(btn){ btn.classList.remove('off'); btn.textContent = 'ON'; }
    if(b.pct === 0) b.pct = 50;
    const slider = document.getElementById('burner-'+num+'-slider');
    if(slider) slider.value = b.pct;
    const pctEl = document.getElementById('burner-'+num+'-pct');
    if(pctEl) pctEl.textContent = b.pct + '%';
  }
  applyBurnersToFurnace();
  updateFurnaceModal();
  showToastInline('Burner '+num+' '+(b.on?'LIT':'EXTINGUISHED')+' — Active: '+getActiveBurnerCount()+'/4');
}

function updateBurnerFromSlider(num){
  const slider = document.getElementById('burner-'+num+'-slider');
  const pct = parseInt(slider.value);
  window._burners[num].pct = pct;
  document.getElementById('burner-'+num+'-pct').textContent = pct + '%';
  applyBurnersToFurnace();
  updateFurnaceModal();
}

function setAllBurners(pct){
  for(let i=1; i<=4; i++){
    window._burners[i].on = true;
    window._burners[i].pct = pct;
    const slider = document.getElementById('burner-'+i+'-slider');
    if(slider) slider.value = pct;
    const pctEl = document.getElementById('burner-'+i+'-pct');
    if(pctEl) pctEl.textContent = pct + '%';
    const row = document.getElementById('burner-'+i+'-row');
    if(row) row.classList.remove('off');
    const btn = document.getElementById('burner-'+i+'-toggle');
    if(btn){ btn.classList.remove('off'); btn.textContent = 'ON'; }
  }
  applyBurnersToFurnace();
  updateFurnaceModal();
  showToastInline('All burners set to '+pct+'%');
}

function openFurnaceModal(){
  try {
    const modal = document.getElementById('furnaceModal');
    if(!modal){
      console.log('furnaceModal element not found in DOM');
      return;
    }
    for(let i=1; i<=4; i++){
      const b = window._burners[i];
      const slider = document.getElementById('burner-'+i+'-slider');
      if(slider) slider.value = b.pct;
      const pctEl = document.getElementById('burner-'+i+'-pct');
      if(pctEl) pctEl.textContent = b.pct + '%';
      const row = document.getElementById('burner-'+i+'-row');
      const btn = document.getElementById('burner-'+i+'-toggle');
      if(row && btn){
        if(b.on){
          row.classList.remove('off');
          btn.classList.remove('off');
          btn.textContent = 'ON';
        } else {
          row.classList.add('off');
          btn.classList.add('off');
          btn.textContent = 'OFF';
        }
      }
    }
    updateFurnaceModal();
    modal.classList.add('show');
  } catch(e){
    console.log('openFurnaceModal error:', e.message);
  }
}

function closeFurnaceModal(){
  document.getElementById('furnaceModal').classList.remove('show');
}

function updateFurnaceModal(){
  const tempSlider = document.getElementById('sl-temp');
  const feedSlider = document.getElementById('sl-feed');
  if(!tempSlider || !feedSlider) return;
  const T = parseFloat(tempSlider.value);
  const F = parseFloat(feedSlider.value);
  
  const tempEl = document.getElementById('fm-temp');
  if(tempEl) tempEl.textContent = T.toFixed(0)+'°C';
  
  const firing = getTotalFiring();
  const activeCount = getActiveBurnerCount();
  const firingEl = document.getElementById('fm-firing');
  if(firingEl) firingEl.textContent = firing.toFixed(0)+'% ('+activeCount+'/4 lit)';
  
  const feedEl = document.getElementById('fm-feed');
  if(feedEl) feedEl.textContent = F.toLocaleString()+' bbl/d';
  
  const stat = document.getElementById('fm-status');
  if(stat){
    if(F < 1000){
      stat.textContent = '⛔ NO FEED';
      stat.style.color = '#e74c3c';
    } else if(activeCount === 0){
      stat.textContent = '⛔ ALL OFF';
      stat.style.color = '#e74c3c';
    } else if(T < 250){
      stat.textContent = '💨 PURGING';
      stat.style.color = '#f59e0b';
    } else if(T < 350){
      stat.textContent = '🔥 LIGHTING ('+activeCount+'/4)';
      stat.style.color = '#f59e0b';
    } else if(T > 415){
      stat.textContent = '⚠ DANGER!';
      stat.style.color = '#e74c3c';
    } else if(activeCount < 4){
      stat.textContent = '🟡 PARTIAL ('+activeCount+'/4)';
      stat.style.color = '#f59e0b';
    } else {
      stat.textContent = '✓ ON-LINE (4/4)';
      stat.style.color = '#2ecc71';
    }
  }
}

function setFurnaceTemp(t){
  const target_firing = Math.max(0, Math.min(100, (t-200)/230 * 100));
  setAllBurners(Math.round(target_firing));
  showToastInline('Furnace setpoint → '+t+'°C ('+Math.round(target_firing)+'% firing)');
}

function furnaceAction(action){
  const tempSlider = document.getElementById('sl-temp');
  const feedSlider = document.getElementById('sl-feed');
  
  if(action === 'shutdown'){
    for(let i=1; i<=4; i++){
      window._burners[i].on = false;
      window._burners[i].pct = 0;
    }
    feedSlider.value = 0;
    if(window._furnaceCoolDown) clearInterval(window._furnaceCoolDown);
    showToastInline('⛔ FURNACE SHUTDOWN — All 4 burners killed, feed cut');
    window._furnaceCoolDown = setInterval(()=>{
      const T = parseFloat(tempSlider.value);
      if(T > 200){
        tempSlider.value = Math.max(200, T - 5);
        sim();
        if(document.getElementById('furnaceModal').classList.contains('show')){
          updateFurnaceModal();
        }
      } else {
        clearInterval(window._furnaceCoolDown);
        window._furnaceCoolDown = null;
        showToastInline('🟢 Furnace cooled to 200°C — safe');
      }
    }, 1500);
    sim();
    if(document.getElementById('furnaceModal').classList.contains('show')){
      openFurnaceModal();
    }
  }
  else if(action === 'purge'){
    if(window._furnaceCoolDown){ clearInterval(window._furnaceCoolDown); window._furnaceCoolDown = null; }
    for(let i=1; i<=4; i++){
      window._burners[i].on = false;
      window._burners[i].pct = 0;
    }
    tempSlider.value = 200;
    sim();
    if(document.getElementById('furnaceModal').classList.contains('show')){
      openFurnaceModal();
    }
    showToastInline('💨 Steam purging — all burners off — wait 10 min');
  }
  else if(action === 'light'){
    if(window._furnaceCoolDown){ clearInterval(window._furnaceCoolDown); window._furnaceCoolDown = null; }
    for(let i=1; i<=4; i++){
      window._burners[i].on = true;
      window._burners[i].pct = 50;
    }
    applyBurnersToFurnace();
    if(document.getElementById('furnaceModal').classList.contains('show')){
      openFurnaceModal();
    }
    showToastInline('🔥 All 4 burners LIT at 50% — slow ramp');
  }
}

