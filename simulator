function calcEnergy(){
  const feed_bbld = parseFloat(document.getElementById('en-feed').value) || 0;
  const tin = parseFloat(document.getElementById('en-tin').value) || 0;
  const tout = parseFloat(document.getElementById('en-tout').value) || 0;
  const cp = parseFloat(document.getElementById('en-cp').value) || 2.5;
  const rho = parseFloat(document.getElementById('en-rho').value) || 850;
  const eff = parseFloat(document.getElementById('en-eff').value) || 82;
  
  // Convert bbl/d to kg/s: 1 bbl = 0.159 m³
  const feed_m3s = feed_bbld * 0.159 / 86400;
  const feed_kgs = feed_m3s * rho;
  
  const dT = tout - tin;
  const Q_abs = feed_kgs * cp * dT;  // kW
  const Q_fired = Q_abs / (eff/100);  // kW gross
  
  // Convert to industry units
  const Q_abs_mmbtu = Q_abs * 0.003412;  // kW → MMBtu/hr
  const Q_fired_mmbtu = Q_fired * 0.003412;
  
  // Estimated fuel gas (LHV ~50 MJ/kg)
  const fuel_kgs = Q_fired / 50000;
  const fuel_tph = fuel_kgs * 3.6;
  
  document.getElementById('en-result').innerHTML = 
    '<div class="calc-result-title">FURNACE DUTY</div>' +
    '<div class="calc-row"><span>Mass flow:</span><b>' + feed_kgs.toFixed(1) + ' kg/s</b></div>' +
    '<div class="calc-row"><span>ΔT across furnace:</span><b>' + dT.toFixed(0) + ' °C</b></div>' +
    '<div class="calc-row"><span>Heat absorbed (Q):</span><b>' + Q_abs.toFixed(0) + ' kW</b></div>' +
    '<div class="calc-row"><span>Heat absorbed (Q):</span><b>' + Q_abs_mmbtu.toFixed(1) + ' MMBtu/hr</b></div>' +
    '<div class="calc-row"><span>Heat fired (gross):</span><b style="color:#ff8050;">' + Q_fired_mmbtu.toFixed(1) + ' MMBtu/hr</b></div>' +
    '<div class="calc-row"><span>Heat losses:</span><b>' + ((Q_fired - Q_abs) * 0.003412).toFixed(1) + ' MMBtu/hr</b></div>' +
    '<div class="calc-row"><span>Est. fuel gas:</span><b>' + fuel_tph.toFixed(2) + ' t/hr</b></div>' +
    '<div class="calc-note">📝 Typical VDU furnace duty: 30-50 MMBtu/hr. Efficiency 80-85% with proper O2 control.</div>';
}

