function openDiagnose(){
  window._diagState = {currentNode: 'root', history: ['root']};
  renderDiagnose();
  const modal = document.getElementById('diagnoseModal');
  if(modal) modal.classList.add('show');
}

function closeDiagnose(){
  const modal = document.getElementById('diagnoseModal');
  if(modal) modal.classList.remove('show');
}

function diagNavigate(nextId){
  window._diagState.currentNode = nextId;
  window._diagState.history.push(nextId);
  renderDiagnose();
}

function diagBack(){
  if(window._diagState.history.length > 1){
    window._diagState.history.pop();
    window._diagState.currentNode = window._diagState.history[window._diagState.history.length - 1];
    renderDiagnose();
  }
}

function diagRestart(){
  window._diagState = {currentNode: 'root', history: ['root']};
  renderDiagnose();
}

