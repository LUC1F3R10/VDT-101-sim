function drawTrend(id,data,mn,mx,col,unit){
  const cv=document.getElementById(id);if(!cv)return;
  const ctx=cv.getContext('2d');const W=cv.width,H=cv.height;
  ctx.clearRect(0,0,W,H);ctx.fillStyle='#060e1a';ctx.fillRect(0,0,W,H);
  ctx.strokeStyle='rgba(26,48,80,.5)';ctx.lineWidth=.5;
  for(let i=0;i<=4;i++){const y=H/4*i;ctx.beginPath();ctx.moveTo(0,y);ctx.lineTo(W,y);ctx.stroke();}
  ctx.fillStyle='#3a5a7a';ctx.font='7px monospace';
  const mxL=mx<10?mx.toFixed(2):mx.toFixed(0);const mnL=mn<10?mn.toFixed(2):mn.toFixed(0);
  ctx.fillText(mxL+unit,2,9);ctx.fillText(mnL+unit,2,H-2);
  ctx.beginPath();ctx.strokeStyle=col;ctx.lineWidth=1.5;
  data.forEach((v,i)=>{
    const x=i/(TLEN-1)*W;
    const y=H-Math.max(0,Math.min(1,(v-mn)/(mx-mn)))*H;
    i===0?ctx.moveTo(x,y):ctx.lineTo(x,y);
  });
  ctx.stroke();
  const lv=data[data.length-1];const lx=W-2;const ly=H-Math.max(0,Math.min(1,(lv-mn)/(mx-mn)))*H;
  ctx.beginPath();ctx.arc(lx,Math.max(3,Math.min(H-3,ly)),3,0,Math.PI*2);ctx.fillStyle=col;ctx.fill();
  ctx.fillStyle=col;ctx.font='bold 8px monospace';ctx.textAlign='right';
  const lbl=lv<10?lv.toFixed(3):lv.toFixed(1);
  ctx.fillText(lbl+unit,W-6,12);ctx.textAlign='left';
}

