}

function tick(){
  try {
    if(running) simTime++;
    const h=Math.floor(simTime/3600),m=Math.floor((simTime%3600)/60),s=simTime%60;
    const clk = document.getElementById('rtclock');
    if(clk) clk.textContent = String(h).padStart(2,'0')+':'+String(m).padStart(2,'0')+':'+String(s).padStart(2,'0');
    if(running) {
      // Advance dynamic state by 1 sim second × time-acceleration factor (10x for usability)
      // Real refinery τ values would take 5-10 minutes to see — we accelerate 10x
      // so 1 sec real = 10 sec sim time → τ=180 (3min) shows progress in ~30 sec
      if(typeof dynStep === 'function') dynStep(10);
      sim();
      // Refresh active section view (HX, Pumps, Furnace, Tower, Score)
      if(typeof refreshActiveSection === 'function') refreshActiveSection();
      // Sample scoring metrics
      if(typeof scoreSample === 'function') scoreSample();
