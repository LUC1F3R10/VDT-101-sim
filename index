<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>VDT-101 Simulator - Petroleum Engineering</title>
    <style>
        :root {
            --bg-color: #0f172a;
            --card-bg: #1e293b;
            --text-color: #f8fafc;
            --primary: #38bdf8;
            --success: #22c55e;
            --warning: #eab308;
            --danger: #ef4444;
        }

        body {
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
            background-color: var(--bg-color);
            color: var(--text-color);
            margin: 0;
            padding: 20px;
            display: flex;
            flex-direction: column;
            align-items: center;
        }

        .container {
            width: 100%;
            max-width: 1200px;
            background: var(--card-bg);
            padding: 25px;
            border-radius: 15px;
            box-shadow: 0 10px 25px rgba(0,0,0,0.3);
        }

        h1 {
            text-align: center;
            color: var(--primary);
            margin-bottom: 30px;
            font-weight: 600;
            letter-spacing: 1px;
        }

        .dashboard {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
            gap: 25px;
            margin-bottom: 30px;
        }

        .card {
            background: rgba(15, 23, 42, 0.5);
            padding: 20px;
            border-radius: 12px;
            border: 1px solid rgba(56, 189, 248, 0.1);
            text-align: center;
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            min-height: 220px;
        }

        .card h3 {
            margin-top: 0;
            margin-bottom: 15px;
            color: #94a3b8;
            font-size: 1.1rem;
        }

        /* إصلاح تداخل العدادات الدائرية */
        .gauge-container {
            position: relative;
            width: 160px;
            height: 160px;
            display: flex;
            align-items: center;
            justify-content: center;
        }

        svg {
            width: 100%;
            height: 100%;
            transform: rotate(-90deg);
        }

        circle {
            fill: none;
            stroke-width: 12;
        }

        .bg-circle {
            stroke: #334155;
        }

        .data-circle {
            stroke: var(--primary);
            stroke-dasharray: 440;
            stroke-dashoffset: 440;
            transition: stroke-dashoffset 0.5s ease;
            stroke-linecap: round;
        }

        .gauge-value {
            position: absolute;
            font-size: 1.6rem;
            font-weight: bold;
            color: var(--text-color);
            text-align: center;
            pointer-events: none;
        }

        .controls {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
            gap: 25px;
        }

        .control-panel {
            background: rgba(15, 23, 42, 0.3);
            padding: 20px;
            border-radius: 12px;
            border: 1px solid rgba(255,255,255,0.05);
        }

        .control-panel h3 {
            margin-top: 0;
            color: var(--primary);
            border-bottom: 1px solid rgba(56, 189, 248, 0.2);
            padding-bottom: 10px;
        }

        .btn-group {
            display: flex;
            gap: 10px;
            margin-bottom: 20px;
        }

        button {
            flex: 1;
            padding: 12px;
            border: none;
            border-radius: 8px;
            cursor: pointer;
            font-weight: bold;
            transition: all 0.3s ease;
            background: #334155;
            color: #94a3b8;
        }

        button.active {
            background: var(--primary);
            color: var(--bg-color);
            box-shadow: 0 0 15px rgba(56, 189, 248, 0.4);
        }

        button:hover:not(.active) {
background: #475569;
            color: #f8fafc;
        }

        .slider-container {
            margin-bottom: 20px;
        }

        .slider-container label {
            display: block;
            margin-bottom: 8px;
            color: #94a3b8;
        }

        input[type="range"] {
            width: 100%;
            height: 6px;
            background: #334155;
            border-radius: 5px;
            outline: none;
            -webkit-appearance: none;
        }

        input[type="range"]::-webkit-slider-thumb {
            -webkit-appearance: none;
            width: 18px;
            height: 18px;
            border-radius: 50%;
            background: var(--primary);
            cursor: pointer;
            box-shadow: 0 0 10px rgba(56, 189, 248, 0.5);
        }

        .status-grid {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 15px;
        }

        .status-item {
            background: rgba(15, 23, 42, 0.6);
            padding: 12px;
            border-radius: 8px;
            text-align: center;
        }

        .status-label {
            font-size: 0.85rem;
            color: #64748b;
            margin-bottom: 5px;
        }

        .status-val {
            font-size: 1.2rem;
            font-weight: bold;
        }

        .status-val.success { color: var(--success); }
        .status-val.warning { color: var(--warning); }
        .status-val.danger { color: var(--danger); }
    </style>
</head>
<body>

    <div class="container">
        <h1>VDT-101 Advanced Valve Simulator</h1>

        <div class="dashboard">
            <div class="card">
                <h3>Flow Rate (PV)</h3>
                <div class="gauge-container">
                    <svg>
                        <circle class="bg-circle" cx="80" cy="80" r="70"></circle>
                        <circle class="data-circle" id="pvGauge" cx="80" cy="80" r="70"></circle>
                    </svg>
                    <div class="gauge-value" id="pvVal">0.0 m³/h</div>
                </div>
            </div>

            <div class="card">
                <h3>Setpoint (SP)</h3>
                <div class="gauge-container">
                    <svg>
                        <circle class="bg-circle" cx="80" cy="80" r="70"></circle>
                        <circle class="data-circle" id="spGauge" cx="80" cy="80" r="70" style="stroke: #eab308;"></circle>
                    </svg>
                    <div class="gauge-value" id="spVal">50.0 m³/h</div>
                </div>
            </div>

            <div class="card">
                <h3>Valve Position (OP)</h3>
                <div class="gauge-container">
                    <svg>
                        <circle class="bg-circle" cx="80" cy="80" r="70"></circle>
                        <circle class="data-circle" id="opGauge" cx="80" cy="80" r="70" style="stroke: #22c55e;"></circle>
                    </svg>
                    <div class="gauge-value" id="opVal">0.0 %</div>
                </div>
            </div>
        </div>

        <div class="controls">
            <div class="control-panel">
                <h3>Control Mode</h3>
                <div class="btn-group">
                    <button id="mode-manual" class="active" onclick="setMode('manual')">MANUAL</button>
                    <button id="mode-auto" onclick="setMode('auto')">AUTO</button>
                    <button id="mode-cascade" onclick="setMode('cascade')">CASCADE</button>
                </div>

                <div class="slider-container">
                    <label id="sliderLabel" for="mainSlider">Manual Output (OP): <span id="sliderVal">0%</span></label>
                    <input type="range" id="mainSlider" min="0" max="100" value="0" oninput="handleSlider(this.value)">
                </div>
            </div>

            <div class="control-panel">
                <h3>System Diagnostics</h3>
                <div class="status-grid">
                    <div class="status-item">
<div class="status-label">Loop Status</div>
                        <div class="status-val success" id="loopStatus">STABLE</div>
                    </div>
                    <div class="status-item">
                        <div class="status-label">Valve Delta P</div>
                        <div class="status-val" id="deltaP">2.4 bar</div>
                    </div>
                    <div class="status-item">
                        <div class="status-label">Error (SP - PV)</div>
                        <div class="status-val" id="errorVal">0.0</div>
                    </div>
                    <div class="status-item">
                        <div class="status-label">Interlock System</div>
                        <div class="status-val success">NORMAL</div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <script>
        // State Variables
        let currentMode = 'manual';
        let pv = 0.0;
        let sp = 50.0;
        let op = 0.0;
        
        // PID Constants (Simulated)
        const Kp = 1.2;
        const Ki = 0.05;
        let integralError = 0;

        // Initialize Gauges
        function updateGauge(gaugeId, value, max, circumference = 440) {
            const gauge = document.getElementById(gaugeId);
            const offset = circumference - (value / max) * circumference;
            gauge.style.strokeDashoffset = offset;
        }

        function setMode(mode) {
            currentMode = mode;
            
            // Update UI buttons
            document.getElementById('mode-manual').classList.remove('active');
            document.getElementById('mode-auto').classList.remove('active');
            document.getElementById('mode-cascade').classList.remove('active');
            
            document.getElementById('mode-' + mode).classList.add('active');

            const slider = document.getElementById('mainSlider');
            const label = document.getElementById('sliderLabel');

            if (mode === 'manual') {
                label.innerHTML = 'Manual Output (OP): <span id="sliderVal">' + op.toFixed(0) + '%</span>';
                slider.min = 0;
                slider.max = 100;
                slider.value = op;
            } else if (mode === 'auto') {
                label.innerHTML = 'Set Point (SP): <span id="sliderVal">' + sp.toFixed(0) + ' m³/h</span>';
                slider.min = 0;
                slider.max = 120;
                slider.value = sp;
            } else {
                label.innerHTML = 'Cascade Master SP: <span id="sliderVal">Remote</span>';
                slider.value = 75;
            }
        }

        function handleSlider(val) {
            const numericVal = parseFloat(val);
            if (currentMode === 'manual') {
                op = numericVal;
                document.getElementById('sliderVal').innerText = op.toFixed(0) + '%';
            } else if (currentMode === 'auto') {
                sp = numericVal;
                document.getElementById('sliderVal').innerText = sp.toFixed(0) + ' m³/h';
            }
        }

        // Process Simulation Loop
        setInterval(() => {
            if (currentMode === 'manual') {
                // In manual, PV chases OP based on system hydraulics
                const targetPV = (op / 100) * 110; 
                pv += (targetPV - pv) * 0.1; // System lag
                integralError = 0;
            } else if (currentMode === 'auto' || currentMode === 'cascade') {
                if (currentMode === 'cascade') {
                    // Simulate a slow moving remote master setpoint
                    sp = 70 + Math.sin(Date.now() / 10000) * 15;
                }

                // PID Algorithm execution
                const error = sp - pv;
                integralError += error * 0.1;
                integralError = Math.max(-50, Math.min(50, integralError)); // Anti-windup
                
                let pidOutput = (error * Kp) + (integralError * Ki);
                op = Math.
max(0, Math.min(100, pidOutput)); // Saturation limits
                
                // Process response
                pv += (op / 100 * 110 - pv) * 0.15 + (Math.random() - 0.5) * 0.2; 
            }

            // Calculations for diagnostics
            const currentError = sp - pv;
            const simulatedDeltaP = Math.max(0.5, 4.0 - (op / 100) * 2.5);

            // Update UI elements safely
            document.getElementById('pvVal').innerText = pv.toFixed(1) + ' m³/h';
            document.getElementById('spVal').innerText = sp.toFixed(1) + ' m³/h';
            document.getElementById('opVal').innerText = op.toFixed(1) + ' %';
            document.getElementById('deltaP').innerText = simulatedDeltaP.toFixed(2) + ' bar';
            document.getElementById('errorVal').innerText = currentError.toFixed(1);

            // Dynamic stability status
            const statusEl = document.getElementById('loopStatus');
            if (Math.abs(currentError) < 1.5) {
                statusEl.innerText = 'STABLE';
                statusEl.className = 'status-val success';
            } else if (Math.abs(currentError) < 5.0) {
                statusEl.innerText = 'TUNING';
                statusEl.className = 'status-val warning';
            } else {
                statusEl.innerText = 'UNSTABLE';
                statusEl.className = 'status-val danger';
            }

            // Update Circle Gauges
            updateGauge('pvGauge', pv, 120);
            updateGauge('spGauge', sp, 120);
            updateGauge('opGauge', op, 100);

        }, 200);
    </script>
</body>
</html>
